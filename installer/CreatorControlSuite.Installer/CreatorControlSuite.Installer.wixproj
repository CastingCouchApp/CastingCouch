<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>CreatorControlSuite-x64</OutputName>
    <Platform>x64</Platform>
    <OutputPath>../../artifacts/installer/</OutputPath>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.0</ProductVersion>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);PublishDir=$(PublishDir);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>
</Project>