{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build Creator Control Suite",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/CreatorControlSuite.App/CreatorControlSuite.App.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run Creator Control Suite",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/run-app.ps1"
      ],
      "problemMatcher": "$msCompile",
      "group": "none"
    }
  ]
}
