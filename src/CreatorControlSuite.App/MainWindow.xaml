                                    <ComboBoxItem Content="Nur Schreibzugriffe" Tag="WRITE"/>
                                    <ComboBoxItem Content="Nur Fehler" Tag="ERROR"/>
                                    <ComboBoxItem Content="Nur OAuth" Tag="OAUTH"/>
                                </ComboBox>
                                <TextBlock x:Name="SpotifyInspectorTypeSummaryText" Text="Noch keine Aufrufe." Foreground="#AEB8C2" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
