                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="RefreshRunOfShowStreamerBotActionsButton" Content="STREAMER.BOT-AKTIONEN LADEN"/>
                                        <CheckBox x:Name="RunOfShowContinueOnActionErrorBox" Content="Bei Fehler trotzdem fortfahren" IsChecked="False" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,10,0,0"><TextBlock Text="Wartezeit vor Aktion" VerticalAlignment="Center"/><TextBox x:Name="RunOfShowActionDelayBox" Width="70" Text="0" Margin="8,0"/><TextBlock Text="ms" VerticalAlignment="Center"/></WrapPanel>
                                    <Separator Margin="0,16,0,12"/>
                                    <TextBlock Text="Twitch-Kanal" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                    <CheckBox x:Name="RunOfShowUpdateTwitchBox" Content="Titel und/oder Kategorie bei diesem Schritt aktualisieren" Margin="0,8,0,0"/>
                                    <TextBlock Text="Streamtitel (leer = unverändert)" Margin="0,10,0,4"/><TextBox x:Name="RunOfShowTwitchTitleBox"/>
                                    <TextBlock Text="Kategorie suchen" Margin="0,10,0,4"/>
                                    <DockPanel>
                                        <Button x:Name="SearchRunOfShowTwitchCategoryButton" Content="SUCHEN" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                        <TextBox x:Name="RunOfShowTwitchCategorySearchBox"/>
                                    </DockPanel>
                                    <ComboBox x:Name="RunOfShowTwitchCategoryResultsBox" Margin="0,8,0,0" DisplayMemberPath="Name"/>
