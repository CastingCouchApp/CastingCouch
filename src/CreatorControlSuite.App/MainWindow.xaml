                                    <Button x:Name="DisconnectObsButton" Grid.Column="1" Content="Trennen"/>
                                    <Button x:Name="RefreshObsButton" Grid.Column="2" Content="Szenen und Quellen laden"/>
                                    <TextBlock x:Name="ObsConnectionStatusText" Grid.Column="3" Text="Nicht verbunden" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </Grid>
                                <Border Background="{DynamicResource InputAltBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                                    <Grid>
