                                        <Border Background="{DynamicResource InputAltBackgroundBrush}" Padding="12" Margin="4"><StackPanel><TextBlock Text="Peak Viewer" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="WorkflowPeakViewersText" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
                                        <Border Background="{DynamicResource InputAltBackgroundBrush}" Padding="12" Margin="4"><StackPanel><TextBlock Text="Ø Viewer" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="WorkflowAverageViewersText" Text="0,0" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
                                        <Border Background="{DynamicResource InputAltBackgroundBrush}" Padding="12" Margin="4"><StackPanel><TextBlock Text="Neue Follower" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="WorkflowFollowersText" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
                                        <Border Background="{DynamicResource InputAltBackgroundBrush}" Padding="12" Margin="4"><StackPanel><TextBlock Text="Chat / Alerts" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="WorkflowChatAlertsText" Text="0 / 0" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
                                    </UniformGrid>
                                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WorkflowViewerSampleBox" Text="0"/><Button x:Name="AddViewerSampleButton" Grid.Column="1" Content="Viewer-Sample hinzufügen"/></Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Regieplan">
