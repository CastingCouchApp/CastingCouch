                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Szenen" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            <ListBox x:Name="ObsScenesList" Height="220" Margin="0,9,0,0" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" DisplayMemberPath="Name"/>
                                            <Button x:Name="SwitchObsSceneButton" Content="Ausgewählte Szene aktivieren" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Quellen" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            <ListBox x:Name="ObsInputsList" Height="220" Margin="0,9,0,0" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" DisplayMemberPath="Name"/>
                                            <TextBlock x:Name="ObsServerInfoText" Text="OBS-Informationen erscheinen nach der Verbindung." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="StartObsStreamButton" Content="Stream starten" Background="#416B3C"/>
                                    <Button x:Name="StopObsStreamButton" Grid.Column="1" Content="Stream beenden" Background="#7A3838"/>
                                    <TextBlock x:Name="ObsStreamStatusText" Grid.Column="2" Text="Streamstatus unbekannt" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Twitch">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18">
                                <TextBlock Text="Client-ID" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="TwitchClientIdBox"/>
                                <TextBlock Text="Client-ID: Im Twitch Developer Console eine Anwendung anlegen. Entwicklerportal: https://dev.twitch.tv/console/apps" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="Kanalname" Foreground="{DynamicResource AccentBrush}" Margin="0,14,0,6"/>
                                <TextBox x:Name="TwitchChannelBox"/>
                                <TextBlock Text="Creator-Dashboard-URL" Foreground="{DynamicResource AccentBrush}" Margin="0,14,0,6"/>
                                <TextBox x:Name="TwitchCreatorDashboardUrlBox"/>
