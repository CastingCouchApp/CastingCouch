                                    <CheckBox x:Name="ShortTestStreamerBotBox" Content="Streamer.bot-Verbindung prüfen" IsChecked="True" Margin="6"/>
                                    <CheckBox x:Name="ShortTestOverlayBox" Content="Overlay-Datei prüfen" IsChecked="True" Margin="6"/>
                                    <CheckBox x:Name="ShortTestAlertBox" Content="Ausgewählten Suite-Alert testen" Margin="6"/>
                                    <CheckBox x:Name="ShortTestAutomationBox" Content="Ausgewählte Automatisierungsregel testen" Margin="6"/>
                                </UniformGrid>
                                <WrapPanel Margin="0,18,0,10">
                                    <Button x:Name="StartShortStreamTestButton" Content="KURZTEST STARTEN" Background="#416B3C" FontWeight="Bold"/>
                                    <Button x:Name="CancelShortStreamTestButton" Content="ABBRECHEN" Background="#7A3838"/>
                                </WrapPanel>
                                <TextBlock x:Name="ShortStreamTestStatusText" Text="Bereit." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <ListBox x:Name="ShortStreamTestResultsList" MinHeight="260" Background="{DynamicResource SidebarBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
            <Grid x:Name="DiagnosticsPage" Visibility="Collapsed">
