<?xml version='1.0' encoding='UTF-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Class="CreatorControlSuite.App.MainWindow"
        Title="Creator Control Suite"
        Width="1600"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource ScrollBarBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ScrollBarForegroundBrush}"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                    <Border Width="18" Height="18" CornerRadius="4" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Margin="0,0,10,0">
                        <TextBlock Text="N"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="11"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource AppHeadingFontFamily}"/>
                    </Border>
                    <TextBlock Text="NEXORA"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppHeadingFontFamily}"/>
                    <TextBlock Text="· Creator Control Suite"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="TitleBarMusicWidget"
                            Margin="0,0,8,0"
                            Padding="8,0"
                            VerticalAlignment="Stretch"
                            Cursor="Hand"
                            Background="Transparent"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Music Player öffnen">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="3" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <Image x:Name="TitleBarMusicCoverImage" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock x:Name="TitleBarMusicTrackText"
                                       Text="Kein Titel"
                                       MaxWidth="180"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12"
                                       Margin="0,0,8,0"/>
                            <Button x:Name="TitleBarMusicPreviousButton"
                                    Style="{StaticResource TitleBarCaptionButtonStyle}"
                                    Width="28"
                                    Content="⏮"
                                    ToolTip="Zurück"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button x:Name="TitleBarMusicPlayPauseButton"
                                    Style="{StaticResource TitleBarCaptionButtonStyle}"
                                    Width="28"
                                    Content="▶"
                                    ToolTip="Play/Pause"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button x:Name="TitleBarMusicNextButton"
                                    Style="{StaticResource TitleBarCaptionButtonStyle}"
                                    Width="28"
                                    Content="⏭"
                                    ToolTip="Weiter"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="TitleBarMinimizeButton"
                            Style="{StaticResource TitleBarCaptionButtonStyle}"
                            ToolTip="Minimieren"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="TitleBarMinimizeButton_Click">
                        <Path Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.4"
                              Data="M0,5 L10,5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="TitleBarMaximizeButton"
                            Style="{StaticResource TitleBarCaptionButtonStyle}"
                            ToolTip="Maximieren"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="TitleBarMaximizeButton_Click">
                        <Grid Width="10" Height="10">
                            <Path x:Name="TitleBarMaximizeIcon"
                                  Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.4" Fill="Transparent"
                                  Data="M0,0 H10 V10 H0 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Path x:Name="TitleBarRestoreIcon"
                                  Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.4" Fill="Transparent"
                                  Visibility="Collapsed"
                                  Data="M2.5,0 H10 V7.5 H2.5 Z M0,2.5 H7.5 V10 H0 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="TitleBarCloseButton"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            ToolTip="Schließen"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="TitleBarCloseButton_Click">
                        <Path Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.4"
                              Data="M0,0 L10,10 M10,0 L0,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource SidebarBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,16">
                        <Border Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="22" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                                    <TextBlock Text="DJ" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="Denver John" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Creator · Twitch" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid>
                            <TextBlock Text="v2.9.1" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Alle Systeme bereit" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel Margin="14,18,14,10">
                        <Grid Margin="6,0,6,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                                <TextBlock Text="N" Foreground="{DynamicResource AccentBrush}" FontSize="30" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource AppHeadingFontFamily}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="NEXORA" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28" FontWeight="Light" FontFamily="{DynamicResource AppHeadingFontFamily}"/>
                                <TextBlock Text="STREAMING CONTROL SUITE" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="DashboardButton" Content="▦   Dashboard" Style="{StaticResource SidebarNavButtonStyle}"/>
                        <Button x:Name="PlayerButton" Content="♫   Player" Style="{StaticResource SidebarNavButtonStyle}"/>
                        <Button x:Name="ServicesButton" Content="⚙   Dienste" Style="{StaticResource SidebarNavButtonStyle}"/>
                        <StackPanel x:Name="ServicesNavigationPanel" Visibility="Collapsed" Margin="16,0,0,4">
                            <Button x:Name="ServicesSpotifyButton" Content="●   Spotify" Style="{StaticResource SidebarNavButtonStyle}" Padding="16,9"/>
                            <Button x:Name="ServicesTwitchButton" Content="▣   Twitch" Style="{StaticResource SidebarNavButtonStyle}" Padding="16,9"/>
                            <Button x:Name="ServicesObsButton" Content="◉   OBS" Style="{StaticResource SidebarNavButtonStyle}" Padding="16,9"/>
                            <Button x:Name="ServicesStreamerBotButton" Content="⚙   Streamer.bot" Style="{StaticResource SidebarNavButtonStyle}" Padding="16,9"/>
                            <Button x:Name="ServicesStreamDeckButton" Content="▦   Stream Deck" Style="{StaticResource SidebarNavButtonStyle}" Padding="16,9"/>
                        </StackPanel>
                        <Button x:Name="WorkflowButton" Content="✣   Automatisierung" Style="{StaticResource SidebarNavButtonStyle}"/>
                        <Button x:Name="MultiPcButton" Content="▣   Multi-PC" Style="{StaticResource SidebarNavButtonStyle}"/>
                        <Button x:Name="StatisticsButton" Content="▥   Statistiken" Style="{StaticResource SidebarNavButtonStyle}"/>
                        <Button x:Name="OverlaysButton" Content="▱   Overlays" Style="{StaticResource SidebarNavButtonStyle}"/>
                        <Button x:Name="AlertsButton" Content="♧   Alerts" Style="{StaticResource SidebarNavButtonStyle}"/>
                        <Button x:Name="SettingsButton" Content="⚙   Einstellungen" Style="{StaticResource SidebarNavButtonStyle}"/>
                        <Button x:Name="DiagnosticsButton" Content="≣   Protokolle" Style="{StaticResource SidebarNavButtonStyle}"/>
                        <Button x:Name="ProfilesButton" Content="Profile" Visibility="Collapsed"/>
                        <Button x:Name="AboutButton" Content="Über die Suite" Visibility="Collapsed"/>
                    </StackPanel>
                </DockPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Column="1" Margin="10,6,0,6" ClipToBounds="True" Background="{DynamicResource WindowBackgroundBrush}">
            <Grid x:Name="DashboardPage" Background="{DynamicResource WindowBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- NEXORA is a working product name and can later be replaced centrally. -->
                <Grid Margin="0,0,0,14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dashboard" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Dein Streaming Command Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="DashboardHeaderStopStreamButtonLegacy" Content="■  STREAM BEENDEN" Style="{StaticResource OrangeActionButtonStyle}" Margin="0,0,8,0" Padding="18,11"/>
                        <Button x:Name="DashboardEditLayoutButton" Content="⚙  LAYOUT" Padding="14,11" Margin="0,0,6,0"/>
                        <Button x:Name="DashboardRestoreHiddenModulesButton" Content="MODULE" Padding="14,11" Margin="0"/>
                        <ComboBox x:Name="DashboardQuickPresetBox" Visibility="Collapsed">
                            <ComboBoxItem Content="Command Center"/>
                        </ComboBox>
                        <Button x:Name="DashboardQuickApplyPresetButton" Visibility="Collapsed" Content="PRESET"/>
                        <Button x:Name="DashboardFocusModeButton" Visibility="Collapsed" Content="FOKUSMODUS"/>
                        <ComboBox x:Name="DashboardDirectSizeBox" Visibility="Collapsed"/>
                        <Button x:Name="DashboardDirectApplySizeButton" Visibility="Collapsed" Content="GRÖSSE"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" ClipToBounds="True">
                    <Grid x:Name="DashboardScrollRoot" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                          MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <Grid x:Name="DashboardContentStack" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2.1*" MinHeight="480"/>
                                <RowDefinition Height="1.7*" MinHeight="400"/>
                                <RowDefinition Height="*" MinHeight="260"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="DashboardTopStatusRow" Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                <Border x:Name="DashboardServiceStatusSection" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="360"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Stream-Widget: Live-Status -->
                                        <Border Margin="5" Padding="12,10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" MinWidth="180" VerticalAlignment="Stretch">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="38" Height="38" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,9,0">
                                                        <TextBlock Text="●" Foreground="{DynamicResource SuccessBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Stream" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                    <Ellipse x:Name="StreamDashboardLamp" Width="7" Height="7" Fill="IndianRed" Margin="0,5,6,0"/>
                                                    <TextBlock x:Name="StreamDashboardStatus" Text="OFFLINE" Foreground="{DynamicResource SuccessBrush}" FontSize="12" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="  "/>
                                                    <TextBlock x:Name="DashboardStreamDetailText" Text="00:00:00" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="NoWrap"/>
                                                </StackPanel>
                                                <Button x:Name="DashboardHeaderStreamActionButton" ToolTip="Stream abhängig vom aktuellen Zustand starten oder beenden" Content="●  LIVE GEHEN" Background="{DynamicResource DangerBrush}" Foreground="{DynamicResource TextOnAccentBrush}" BorderBrush="{DynamicResource DangerBrush}" FontWeight="Bold" Height="30" Padding="12,2" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Qualitäts-Widget neben Stream -->
                                        <Border Grid.Column="1" Margin="5" Padding="12,10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" MinWidth="240" VerticalAlignment="Stretch" x:Name="DashboardStreamQualityModule">
                                            <StackPanel>
                                                <DockPanel LastChildFill="True">
                                                    <Ellipse x:Name="DashboardStreamQualityLamp" Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}" Margin="0,4,7,0" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="Qualität" FontWeight="SemiBold" FontSize="15"/>
                                                    <TextBlock x:Name="DashboardStreamQualityStatusText" Text="OBS nicht verbunden" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                                    <StackPanel Margin="0,0,10,6">
                                                        <TextBlock Text="BITRATE" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                                        <TextBlock x:Name="DashboardStreamBitrateText" Text="0 kbps" FontSize="14" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,6">
                                                        <TextBlock Text="FPS" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                                        <TextBlock x:Name="DashboardStreamFpsText" Text="0 / 60" FontSize="14" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock Text="DROPS" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                                        <TextBlock x:Name="DashboardDroppedFramesText" Text="0 (0 %)" FontSize="13" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="RENDER" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                                        <TextBlock x:Name="DashboardRenderLagText" Text="0 (0 %)" FontSize="13" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock x:Name="DashboardStreamQualityDetailText" Text="Stream ist offline" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Music Player in der Dashboard-Titelleiste -->
                                        <Border x:Name="DashboardTopMusicWidget"
                                                Grid.Column="2"
                                                Margin="5"
                                                Padding="12,10"
                                                Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                MinWidth="360"
                                                VerticalAlignment="Stretch"
                                                Cursor="Hand"
                                                ToolTip="Music Player öffnen">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="84" Height="84" CornerRadius="6" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                                                    <Image x:Name="DashboardTopMusicCoverImage" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="DashboardTopMusicProviderText" Text="MUSIC PLAYER" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="DashboardTopMusicTitleText" Text="Kein Titel" FontSize="18" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                                    <TextBlock x:Name="DashboardTopMusicArtistText" Text="-" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    <TextBlock x:Name="DashboardTopMusicAlbumText" Text="Album: -" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    <TextBlock x:Name="DashboardTopMusicStatusText" Text="Nicht verbunden" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,6,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="DashboardTopMusicPreviousButton" Content="⏮" Width="28" Height="28" FontSize="12" Padding="0" Margin="0,0,4,0" MinWidth="28" MinHeight="28" ToolTip="Zurück"/>
                                                    <Button x:Name="DashboardTopMusicPlayPauseButton" Content="▶" Width="32" Height="28" FontSize="12" FontWeight="Bold" Padding="0" Margin="0,0,4,0" MinWidth="32" MinHeight="28" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextOnAccentBrush}" ToolTip="Play/Pause"/>
                                                    <Button x:Name="DashboardTopMusicNextButton" Content="⏭" Width="28" Height="28" FontSize="12" Padding="0" Margin="0" MinWidth="28" MinHeight="28" ToolTip="Weiter"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <!-- Community-Widgets in der Titelzeile -->
                                        <WrapPanel x:Name="DashboardCommunityModule" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Margin="5" Padding="12,10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" MinWidth="280">
                                                <StackPanel>
                                                    <TextBlock Text="COMMUNITY" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <UniformGrid Columns="4">
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock x:Name="DashboardHeroViewerText" Text="0" FontSize="22" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Zuschauer" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock x:Name="DashboardHeroFollowerText" Text="0" FontSize="22" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Follower" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock x:Name="DashboardChatAlertsText" Text="0" FontSize="22" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Abos" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock x:Name="DashboardCommunityChattersText" Text="0" FontSize="22" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Chatter" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" BorderThickness="1" CornerRadius="5" Margin="0,10,0,0" Padding="6">
                                                        <Grid>
                                                            <Canvas Height="36" ClipToBounds="True">
                                                                <Polyline x:Name="DashboardViewerTrendLine" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                                                            </Canvas>
                                                            <TextBlock Text="-60 Min" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                                                            <TextBlock Text="Jetzt" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <Border Margin="5" Padding="12,10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" MinWidth="260">
                                                <StackPanel>
                                                    <TextBlock Text="SESSION" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                    <UniformGrid Columns="4">
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock x:Name="DashboardPeakViewersText" Text="0" FontSize="18" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Peak" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock x:Name="DashboardAverageViewersText" Text="0" FontSize="18" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Ø Zusch." Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock x:Name="DashboardFollowersGainedText" Text="0" FontSize="18" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Follower +" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                                            <TextBlock x:Name="DashboardFollowerTotalText" Text="Gesamt: 0" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock x:Name="DashboardCommunityUniqueChattersText" Text="0" FontSize="18" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Unique" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <TextBlock x:Name="DashboardTwitchSessionMetricsText" Text="Subs 0 · Gift-Subs 0 · Bits 0 · Raids 0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
