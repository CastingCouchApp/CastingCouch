                                </DockPanel>
                                <CheckBox x:Name="ObsAutoConnectBox" Content="OBS automatisch verbinden" Margin="0,12,0,0"/>
                                <CheckBox x:Name="ObsConnectOnPrepareBox" Content="Bei Stream vorbereiten OBS verbinden" Margin="0,8,0,0"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
