                                    <Button x:Name="DeleteRunOfShowStepButton" Content="LÖSCHEN" Background="#7A3838"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="ImportRunOfShowButton" Content="IMPORTIEREN"/>
                                    <Button x:Name="ExportRunOfShowButton" Content="EXPORTIEREN"/>
                                    <Button x:Name="ValidateRunOfShowButton" Content="PLAN PRÜFEN" Background="#315B72"/>
                                </WrapPanel>
                            </StackPanel>
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="#315B72" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Aktueller Schritt" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="RunOfShowCurrentText" Text="Noch nicht gestartet" FontSize="20" FontWeight="Bold"/></StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock Text="Nächster Schritt" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="RunOfShowNextText" Text="Kein weiterer Schritt" FontSize="20" FontWeight="Bold"/></StackPanel>
                                            <TextBlock x:Name="RunOfShowProgressText" Grid.Column="2" Text="0 / 0" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="Regieschritt bearbeiten" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="18" Margin="0,18,0,0"/>
