                        <DataGrid x:Name="RuntimeHealthGrid" AutoGenerateColumns="True" IsReadOnly="True" Background="{DynamicResource InputAltBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </TabItem>
                    <TabItem Header="Installer-Test">
                        <DataGrid x:Name="InstallerSelfTestGrid" AutoGenerateColumns="True" IsReadOnly="True" Background="{DynamicResource InputAltBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </TabItem>
