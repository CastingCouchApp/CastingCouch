                                    <TextBlock Text="Name" Margin="0,10,0,4"/><TextBox x:Name="RunOfShowNameBox" Text="Neuer Regieschritt"/>
                                    <TextBlock Text="OBS-Szene" Margin="0,10,0,4"/><ComboBox x:Name="RunOfShowSceneBox" IsEditable="True"/>
