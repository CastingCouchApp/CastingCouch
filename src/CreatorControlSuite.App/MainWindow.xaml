                                <CheckBox x:Name="TwitchAutoConnectBox" Content="Twitch automatisch verbinden" Margin="0,12,0,0"/>
                                <CheckBox x:Name="TwitchConnectOnPrepareBox" Content="Bei Stream vorbereiten Twitch verbinden" Margin="0,8,0,0"/>
                                <CheckBox x:Name="TwitchChatEnabledBox" Content="Live-Chat aktivieren" Margin="0,8,0,0"/>
                                <CheckBox x:Name="TwitchEventSubEnabledBox" Content="Follower, Subs, Raids und Cheers empfangen" Margin="0,8,0,0"/>
                                <Border Background="{DynamicResource InputAltBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Twitch-Autorisierung" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                        <TextBlock Text="Für die Desktop-Anwendung wird der Twitch-Gerätecode verwendet. Ein Client-Secret ist nicht erforderlich." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="AuthorizeTwitchButton" Content="Twitch autorisieren" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextOnAccentBrush}" FontWeight="Bold"/>
                                            <Button x:Name="ConnectTwitchButton" Grid.Column="1" Content="Verbinden"/>
                                            <Button x:Name="DisconnectTwitchButton" Grid.Column="2" Content="Trennen"/>
                                            <TextBlock x:Name="TwitchConnectionStatusText" Grid.Column="3" Text="Nicht verbunden" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource InputAltBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Kanal" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                            <TextBlock Text="Streamtitel" Margin="0,10,0,6"/>
                                            <TextBox x:Name="TwitchTitleBox"/>
                                            <TextBlock Text="Kategorie suchen" Margin="0,12,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TwitchCategorySearchBox"/>
                                                <Button x:Name="SearchTwitchCategoryButton" Grid.Column="1" Content="Suchen"/>
                                            </Grid>
                                            <ComboBox x:Name="TwitchCategoryResultsBox" DisplayMemberPath="Name" Margin="0,8,0,0"/>
                                            <Button x:Name="SaveTwitchChannelButton" Content="Titel und Kategorie speichern" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Live Twitch Chat" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                            <ListBox x:Name="TwitchChatList" Height="260" Margin="0,10,0,0" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TwitchChatMessageBox"/>
                                                <Button x:Name="SendTwitchChatButton" Grid.Column="1" Content="Senden"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource InputAltBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Letzte Twitch-Events" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                        <ListBox x:Name="TwitchEventsList" Height="150" Margin="0,10,0,0" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Music Player">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                            <StackPanel Margin="18" Style="{StaticResource CCSDarkSettingsContentStyle}">
                                <TextBlock Text="Aktiver Music Player" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Es ist immer nur ein Music-Player aktiv. Die Wahl gilt für Title-Bar, Player-Seite, Overlay und Connection-Widget." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <RadioButton x:Name="MusicProviderSpotifyRadio" GroupName="MusicPlayerProvider" Content="Spotify" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="MusicProviderYouTubeMusicRadio" GroupName="MusicPlayerProvider" Content="YouTube Music" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel x:Name="SpotifyMusicSettingsPanel">
                                <TextBlock Text="Spotify" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="Client-ID" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="SpotifyClientIdBox"/>
                                <TextBlock Text="Client-ID: Im Spotify Developer Dashboard eine App anlegen. Entwicklerportal: https://developer.spotify.com/dashboard" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="Redirect-URI" Foreground="{DynamicResource AccentBrush}" Margin="0,14,0,6"/>
                                <TextBox x:Name="SpotifyRedirectUriBox"/>
                                <TextBlock Text="Programmpfad zu Spotify" Foreground="{DynamicResource AccentBrush}" Margin="0,14,0,6"/>
                                <DockPanel>
                                    <Button x:Name="BrowseSpotifyExecutableButton" Content="Durchsuchen…" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                    <TextBox x:Name="SpotifyExecutablePathBox"/>
                                </DockPanel>
                                <CheckBox x:Name="SpotifyAutoConnectBox" Content="Spotify automatisch verbinden" Margin="0,12,0,0"/>
                                <CheckBox x:Name="SpotifyConnectOnPrepareBox" Content="Bei Stream vorbereiten Spotify verbinden" Margin="0,8,0,0"/>
                                <Border Background="{DynamicResource InputAltBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Spotify-Autorisierung" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                        <TextBlock Text="Die Desktop-Anwendung verwendet Authorization Code mit PKCE. Ein Client-Secret wird nicht gespeichert." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="AuthorizeSpotifyButton" Content="Spotify autorisieren" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextOnAccentBrush}" FontWeight="Bold"/>
                                            <Button x:Name="ConnectSpotifyButton" Grid.Column="1" Content="Verbinden"/>
                                            <Button x:Name="DisconnectSpotifyButton" Grid.Column="2" Content="Trennen"/>
                                            <Button x:Name="RefreshSpotifyButton" Grid.Column="3" Content="Aktualisieren"/>
                                            <TextBlock x:Name="SpotifyConnectionStatusText" Grid.Column="4" Text="Nicht verbunden" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource InputAltBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Spotify öffnen" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                        <TextBlock Text="Hier wird nur die Verbindung eingerichtet. Die laufende Wiedergabe, Titelinformationen und Player-Steuerung befinden sich unter Player bzw. Dienste → Spotify." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <Button x:Name="OpenSpotifyFromSettingsButton" Content="Spotify öffnen" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Diese Controls bleiben ausschließlich als unsichtbare Kompatibilitätsfelder bestehen,
                                     damit bestehende Einstellungs- und Aktualisierungslogik nicht unterbrochen wird. -->
                                <Grid Visibility="Collapsed" IsHitTestVisible="False">
                                    <ComboBox x:Name="SpotifyDeviceBox" DisplayMemberPath="Name"/>
                                    <ComboBox x:Name="SpotifyPlaylistBox" DisplayMemberPath="Name"/>
                                    <TextBox x:Name="SpotifyVolumeBox"/>
                                    <Button x:Name="StartSpotifyPlaylistButton"/>
                                    <Image x:Name="SpotifyAlbumCoverImage"/>
                                    <TextBlock x:Name="SpotifyTrackText"/>
                                    <TextBlock x:Name="SpotifyAlbumText"/>
                                    <TextBlock x:Name="SpotifyPlaybackDetailText"/>
                                    <Button x:Name="SpotifyPreviousButton"/>
                                    <Button x:Name="SpotifyPlayButton"/>
                                    <Button x:Name="SpotifyPauseButton"/>
                                    <Button x:Name="SpotifyNextButton"/>
                                    <Slider x:Name="SpotifyVolumeSlider" Minimum="0" Maximum="100" Value="100"/>
                                    <TextBlock x:Name="SpotifyVolumeValueText"/>
                                </Grid>
                                <Border Background="{DynamicResource InputAltBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Automatischer Szenenwechsel" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                        <CheckBox x:Name="SpotifyFadeOutBox" Content="Beim Wechsel von Start auf Live herunterfaden" Margin="0,10,0,0"/>
                                        <CheckBox x:Name="SpotifyPauseAfterFadeBox" Content="Nach dem Fade-Out pausieren" Margin="0,8,0,0"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Fade-Out Sekunden" VerticalAlignment="Center"/>
                                            <TextBox x:Name="SpotifyFadeOutSecondsBox" Grid.Column="1"/>
                                            <TextBlock Text="Fade-In Sekunden" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                            <TextBox x:Name="SpotifyFadeInSecondsBox" Grid.Column="3"/>
                                            <Button x:Name="TestSpotifyFadeButton" Grid.Column="4" Content="Fade-Out testen" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Hinweis: Spotify-Playersteuerung erfordert in der Regel Spotify Premium. Spotify-Inhalte dürfen nicht über den Stream ausgestrahlt werden." Foreground="#FFB347" TextWrapping="Wrap" Margin="0,14,0,0"/>
                                </StackPanel>

                                <StackPanel x:Name="YouTubeMusicSettingsPanel" Visibility="Collapsed">
                                    <TextBlock Text="YouTube Music" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="YouTube Music wird über ein Bookmarklet und eine lokale Bridge angebunden. Setup und Steuern findest du auch auf der Player-Seite." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <TextBlock Text="Bridge-Port" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="YouTubeMusicBridgePortBox" Text="43831"/>
                                    <CheckBox x:Name="YouTubeMusicAutoConnectBox" Content="YouTube Music Bridge automatisch starten" Margin="0,12,0,0"/>
                                    <CheckBox x:Name="YouTubeMusicConnectOnPrepareBox" Content="Bei Stream vorbereiten Bridge starten" Margin="0,8,0,0"/>
                                    <Button x:Name="OpenMusicPlayerFromSettingsButton" Content="Player-Seite öffnen" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Streamer.bot">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                            <StackPanel Margin="18" Style="{StaticResource CCSDarkSettingsContentStyle}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                <TextBlock Text="Verbindung zu Streamer.bot" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Host" VerticalAlignment="Center"/>
                                    <TextBox x:Name="StreamerBotHostBox" Grid.Column="1"/>
                                    <TextBlock Text="Port" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBox x:Name="StreamerBotPortBox" Grid.Column="3"/>
                                </Grid>
                                <TextBlock Text="Endpoint" Margin="0,12,0,5"/>
                                <TextBox x:Name="StreamerBotEndpointBox"/>
                                <TextBlock Text="WebSocket-Passwort" Margin="0,12,0,5"/>
                                <PasswordBox x:Name="StreamerBotPasswordBox"/>
                                <TextBlock Text="Programmpfad zu Streamer.bot" Margin="0,12,0,5"/>
                                <DockPanel>
                                    <Button x:Name="BrowseStreamerBotExecutableButton" Content="Durchsuchen…" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                    <TextBox x:Name="StreamerBotExecutablePathBox"/>
                                </DockPanel>
                                <CheckBox x:Name="StreamerBotAutoConnectBox" Content="Streamer.bot automatisch verbinden" Margin="0,10,0,0"/>
                                <CheckBox x:Name="StreamerBotConnectOnPrepareBox" Content="Bei Stream vorbereiten Streamer.bot verbinden" Margin="0,8,0,0"/>
                                <TextBlock Text="Alert-Steuerung" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,18,0,6"/>
                                <TextBlock Text="Die eigentliche Auswahl, Aktivierung und Gestaltung erfolgt auf der Seite Alerts. Hier werden nur die Namen der beiden Streamer.bot-Hilfsaktionen hinterlegt." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Alerts deaktivieren" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="SettingsStreamerBotDisableAlertsActionBox" Grid.Column="1" IsEditable="True" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Alerts aktivieren" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="SettingsStreamerBotEnableAlertsActionBox" Grid.Column="1" IsEditable="True" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                                </Grid>
                                <Border Background="{DynamicResource InputAltBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Kurzanleitung" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="1. Streamer.bot starten.&#10;2. Den WebSocket-Server in Streamer.bot aktivieren.&#10;3. Host, Port und Endpoint prüfen.&#10;4. Dieselben Werte hier eintragen.&#10;5. Unter Dienste → Streamer.bot auf Verbinden klicken.&#10;&#10;Website: https://streamer.bot/&#10;Dokumentation: https://docs.streamer.bot/" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Stream-Workflow">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Startszene" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="StartSceneBox" Grid.Column="1" IsEditable="True" DisplayMemberPath="Name" SelectedValuePath="Name"/>
                                    <TextBlock Text="Live-Szene" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <ComboBox x:Name="LiveSceneBox" Grid.Column="3" IsEditable="True" DisplayMemberPath="Name" SelectedValuePath="Name"/>
                                    <TextBlock Text="Pausenszene" Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                    <ComboBox x:Name="PauseSceneBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" IsEditable="True" DisplayMemberPath="Name" SelectedValuePath="Name"/>
                                    <TextBlock Text="Endszene" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="12,10,0,0"/>
                                    <ComboBox x:Name="EndSceneBox" Grid.Row="1" Grid.Column="3" Margin="0,10,0,0" IsEditable="True" DisplayMemberPath="Name" SelectedValuePath="Name"/>
                                    <TextBlock Text="Endszene-Dauer" Grid.Row="2" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                    <TextBox x:Name="EndSceneSecondsBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"/>
                                </Grid>
                                <Button x:Name="RefreshWorkflowScenesButton" Content="OBS-Szenen neu laden" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                                <TextBlock Text="Die Szenenauswahl gehört zum Stream-Workflow. Beim Streamstart wechselt die Suite die gewählte OBS-Szene per WebSocket. In den HTML-Overlays wird kein OBS-Szenenname gespeichert." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
