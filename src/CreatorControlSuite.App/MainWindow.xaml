                                    <WrapPanel Margin="0,8,0,0"><TextBlock Text="Spotify-Lautstärke" VerticalAlignment="Center"/><TextBox x:Name="RunOfShowSpotifyVolumeBox" Width="70" Text="35" Margin="8,0,0,0"/><TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0"/></WrapPanel>
                                    <Separator Margin="0,16,0,12"/>
                                    <TextBlock Text="Streamer.bot-Aktion" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
