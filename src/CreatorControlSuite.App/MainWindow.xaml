                    <Button x:Name="RunWorkflowE2eButton" Content="Workflow E2E-Test" Background="#5A3D7A"/>
                    <Button x:Name="RunInstallerSelfTestButton" Content="Installer-Selbsttest"/>
                    <Button x:Name="RefreshBetaReadinessButton" Content="Beta-Readiness" Background="#315B72"/>
