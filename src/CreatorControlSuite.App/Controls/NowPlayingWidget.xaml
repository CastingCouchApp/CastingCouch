<UserControl x:Class="CreatorControlSuite.App.Controls.NowPlayingWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="48" d:DesignWidth="220">
    <!--
      Usage: host in any panel and call SetState(MusicPlayerUiState) after
      IMusicPlayerUiPresenter.GetStateAsync(), e.g. in the title-bar music strip.
    -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel VerticalAlignment="Center" MinWidth="120">
            <TextBlock x:Name="TitleText"
                       Text="Kein Titel"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="180"/>
            <TextBlock x:Name="ArtistText"
                       Text="-"
                       FontSize="11"
                       Foreground="{DynamicResource MutedBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="180"/>
        </StackPanel>
        <TextBlock x:Name="PlayingGlyph"
                   Text="▶"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
    </StackPanel>
</UserControl>
