<Window x:Class="CreatorControlSuite.App.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creator Control Suite – Ersteinrichtung"
        Width="900"
        Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#101010"
        Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Creator Control Suite"
                       FontSize="30"
                       FontWeight="Bold"/>
            <TextBlock x:Name="StepTitleText"
                       Text="Willkommen"
                       Foreground="#FF8C00"
                       FontSize="18"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#1A1A1A"
                BorderBrush="#333"
                BorderThickness="1"
                CornerRadius="12"
                Padding="22"
                Margin="0,20,0,18">
            <Grid>
                <Grid x:Name="WelcomeStep">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Willkommen bei der Creator Control Suite"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Dieser Assistent richtet die Grundwerte ein. Twitch und Spotify werden anschließend in der Suite autorisiert."
                                   Foreground="#B5B5B5"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="17"
                                   Margin="40,18,40,0"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="BrandingStep" Visibility="Collapsed">
                    <StackPanel Width="620">
                        <TextBlock Text="Name und Kanal"
                                   Foreground="#FF8C00"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Anzeigename" Margin="0,14,0,4"/>
                        <TextBox x:Name="DisplayNameBox"/>
                        <TextBlock Text="Twitch-Kanalname" Margin="0,14,0,4"/>
                        <TextBox x:Name="ChannelNameBox"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ObsStep" Visibility="Collapsed">
                    <StackPanel Width="620">
                        <TextBlock Text="OBS"
                                   Foreground="#FF8C00"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Host"/>
                                <TextBox x:Name="ObsHostBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Port"/>
                                <TextBox x:Name="ObsPortBox"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Startszene" Margin="0,10,0,4"/>
                        <TextBox x:Name="StartSceneBox"/>
                        <TextBlock Text="Live-Szene" Margin="0,10,0,4"/>
                        <TextBox x:Name="LiveSceneBox"/>
                        <TextBlock Text="Pausenszene" Margin="0,10,0,4"/>
                        <TextBox x:Name="PauseSceneBox"/>
                        <TextBlock Text="Endszene" Margin="0,10,0,4"/>
                        <TextBox x:Name="EndSceneBox"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="OverlayStep" Visibility="Collapsed">
                    <StackPanel Width="620">
                        <TextBlock Text="Overlay"
                                   Foreground="#FF8C00"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Overlay-Ordner" Margin="0,14,0,4"/>
                        <TextBox x:Name="OverlayRootBox"/>
                        <CheckBox x:Name="InstallBundledOverlayBox"
                                  Content="Standard-Overlay installieren"
                                  IsChecked="True"
                                  Margin="0,12,0,0"/>
                        <TextBlock Text="Ein leerer Pfad verwendet den Standardordner unter LocalAppData."
                                   Foreground="#AFAFAF"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SummaryStep" Visibility="Collapsed">
                    <StackPanel Width="680">
                        <TextBlock Text="Zusammenfassung"
                                   Foreground="#FF8C00"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="SummaryText"
                                   TextWrapping="Wrap"
                                   FontSize="17"
                                   Margin="0,14,0,0"/>
                        <CheckBox x:Name="OpenSettingsAfterWizardBox"
                                  Content="Nach Abschluss die Einstellungen öffnen"
                                  IsChecked="True"
                                  Margin="0,18,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton"
                    Content="Abbrechen"
                    Padding="14,9"/>

            <WrapPanel Grid.Column="1">
                <Button x:Name="BackButton"
                        Content="Zurück"
                        IsEnabled="False"
                        Padding="14,9"
                        Margin="4"/>
                <Button x:Name="NextButton"
                        Content="Weiter"
                        Background="#FF8C00"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="14,9"
                        Margin="4"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
