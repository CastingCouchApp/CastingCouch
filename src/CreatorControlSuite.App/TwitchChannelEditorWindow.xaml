<Window x:Class="CreatorControlSuite.App.TwitchChannelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Twitch-Kanal bearbeiten"
        Width="620"
        Height="480"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Twitch-Kanal" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="Streamtitel, Kategorie und Live-Benachrichtigung zentral bearbeiten."
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,5,0,16"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Streamtitel" Margin="0,0,0,5"/>
            <TextBox x:Name="TitleBox" MinHeight="34"/>

            <TextBlock Text="Kategorie" Margin="0,14,0,5"/>
            <Grid x:Name="CategoryTypeaheadHost">
                <TextBox x:Name="CategorySearchBox"
                         MinHeight="34"
                         ToolTip="Tippe, um Kategorien zu suchen"/>
                <Popup x:Name="CategorySuggestionsPopup"
                       PlacementTarget="{Binding ElementName=CategorySearchBox}"
                       Placement="Bottom"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource ElevatedBackgroundBrush}"
                            BorderBrush="{DynamicResource StrongBorderBrush}"
                            BorderThickness="1"
                            MinWidth="{Binding ActualWidth, ElementName=CategorySearchBox}"
                            MaxHeight="220">
                        <ListBox x:Name="CategorySuggestionsBox"
                                 DisplayMemberPath="Name"
                                 BorderThickness="0"
                                 MaxHeight="218"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PreviewMouseLeftButtonUp="CategorySuggestionsBox_OnPreviewMouseLeftButtonUp"/>
                    </Border>
                </Popup>
            </Grid>
            <TextBlock x:Name="CategoryHintText"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11"
                       Margin="0,4,0,0"
                       Text="Tippe einen Namen – Vorschläge erscheinen automatisch."/>

            <TextBlock Text="Live-Benachrichtigung" Margin="0,14,0,5"/>
            <TextBox x:Name="LiveNotificationBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="74"
                     VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="Hinweis: Twitch stellt derzeit keine öffentliche API zum Ändern der Go-live-Benachrichtigung bereit. Der Text wird deshalb in der Suite gespeichert."
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource AccentHoverBrush}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="ABBRECHEN" Padding="16,7"/>
            <Button x:Name="SaveButton"
                    Content="SPEICHERN"
                    Padding="18,7"
                    Margin="8,0,0,0"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource TextOnAccentBrush}"/>
        </StackPanel>
    </Grid>
</Window>
