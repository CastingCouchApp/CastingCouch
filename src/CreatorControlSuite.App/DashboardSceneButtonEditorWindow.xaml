<Window x:Class="CreatorControlSuite.App.DashboardSceneButtonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Szenen-Button"
        Width="440"
        Height="520"
        MinWidth="400"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="OBS-Szene" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="SceneBox" MinHeight="30" Foreground="{DynamicResource TextPrimaryBrush}"/>

                <TextBlock Text="Titel" FontWeight="SemiBold" Margin="0,14,0,4"/>
                <TextBox x:Name="TitleBox" MinHeight="30"/>

                <TextBlock Text="Icon" FontWeight="SemiBold" Margin="0,14,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="EmojiKindRadio" Content="Emoji" IsChecked="True" Margin="0,0,14,0" GroupName="IconKind"/>
                    <RadioButton x:Name="GlyphKindRadio" Content="Glyph" Margin="0,0,14,0" GroupName="IconKind"/>
                    <RadioButton x:Name="ImageKindRadio" Content="Bild" GroupName="IconKind"/>
                </StackPanel>

                <StackPanel x:Name="EmojiPanel">
                    <WrapPanel x:Name="EmojiPickerPanel" Margin="0,0,0,8"/>
                    <TextBox x:Name="EmojiValueBox" MinHeight="30" ToolTip="Eigenes Emoji eingeben"/>
                </StackPanel>

                <StackPanel x:Name="GlyphPanel" Visibility="Collapsed">
                    <ComboBox x:Name="GlyphBox" MinHeight="30" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel x:Name="ImagePanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ImagePathBox" MinHeight="30" IsReadOnly="True"/>
                        <Button x:Name="BrowseImageButton" Grid.Column="1" Content="Datei…" Margin="8,0,0,0" Padding="12,6"/>
                    </Grid>
                    <Border Margin="0,10,0,0" Width="64" Height="64" HorizontalAlignment="Left"
                            Background="{DynamicResource ElevatedBackgroundBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Image x:Name="ImagePreview" Stretch="Uniform" Margin="4"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Abbrechen" Padding="14,8" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="Speichern" Padding="14,8"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource TextOnAccentBrush}"
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
