<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="AppHeadingFontFamily">Impact, Arial Black, Segoe UI</FontFamily>

    <Color x:Key="AccentColor">#FF1493</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF1493"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF69B4"/>
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#C71585"/>
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="#9B0A5A"/>
    <SolidColorBrush x:Key="AccentSelectedDeepBrush" Color="#3A0A20"/>
    <SolidColorBrush x:Key="AccentSelectedForegroundBrush" Color="#FFB6D9"/>
    <SolidColorBrush x:Key="AccentTabBrush" Color="#C71585"/>
    <SolidColorBrush x:Key="AccentTabBorderBrush" Color="#FF69B4"/>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#121212"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0E0E0E"/>
    <SolidColorBrush x:Key="SidebarBackgroundEndBrush" Color="#1A0A12"/>
    <LinearGradientBrush x:Key="TitleBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1C1218" Offset="0"/>
        <GradientStop Color="#0E0E0E" Offset="0.48"/>
        <GradientStop Color="#080608" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TitleBarHighlightBrush" Color="#28FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarDividerBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ElevatedBackgroundBrush" Color="#222222"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="InputAltBackgroundBrush" Color="#161616"/>
    <SolidColorBrush x:Key="ComboBackgroundBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="ComboGlyphBackgroundBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ListBackgroundBrush" Color="#141414"/>
    <SolidColorBrush x:Key="RowBackgroundBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="AlternatingRowBackgroundBrush" Color="#161616"/>
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#2A1520"/>
    <SolidColorBrush x:Key="SettingsTabBackgroundBrush" Color="#121212"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D0A0B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A08090"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboGlyphBrush" Color="#FF69B4"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#FF1493"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#FF69B4"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="#0E0E0E"/>
    <SolidColorBrush x:Key="ScrollBarForegroundBrush" Color="#FF1493"/>

    <SolidColorBrush x:Key="NavHoverBackgroundBrush" Color="#2A0A18"/>
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#3A0A20"/>
    <SolidColorBrush x:Key="NavActiveForegroundBrush" Color="#FF69B4"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#39D353"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB347"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF3366"/>
    <SolidColorBrush x:Key="HighlightItemBrush" Color="#2A1520"/>

    <SolidColorBrush x:Key="PanelBrush" Color="#121212"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A08090"/>
</ResourceDictionary>
