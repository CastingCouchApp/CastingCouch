<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="AppFontFamily">Consolas, Cascadia Mono, Segoe UI</FontFamily>
    <FontFamily x:Key="AppHeadingFontFamily">Consolas, Cascadia Mono, Segoe UI</FontFamily>

    <Color x:Key="AccentColor">#33FF66</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#33FF66"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#66FF99"/>
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#00CC44"/>
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="#1A8833"/>
    <SolidColorBrush x:Key="AccentSelectedDeepBrush" Color="#0A2A10"/>
    <SolidColorBrush x:Key="AccentSelectedForegroundBrush" Color="#33FF66"/>
    <SolidColorBrush x:Key="AccentTabBrush" Color="#1A8833"/>
    <SolidColorBrush x:Key="AccentTabBorderBrush" Color="#33FF66"/>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#050805"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#020402"/>
    <SolidColorBrush x:Key="SidebarBackgroundEndBrush" Color="#0A120A"/>
    <LinearGradientBrush x:Key="TitleBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0A140A" Offset="0"/>
        <GradientStop Color="#020402" Offset="0.48"/>
        <GradientStop Color="#000200" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TitleBarHighlightBrush" Color="#221AFF33"/>
    <SolidColorBrush x:Key="TitleBarDividerBrush" Color="#0E2A14"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0A100A"/>
    <SolidColorBrush x:Key="ElevatedBackgroundBrush" Color="#101810"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0C140C"/>
    <SolidColorBrush x:Key="InputAltBackgroundBrush" Color="#080E08"/>
    <SolidColorBrush x:Key="ComboBackgroundBrush" Color="#0C140C"/>
    <SolidColorBrush x:Key="ComboGlyphBackgroundBrush" Color="#142014"/>
    <SolidColorBrush x:Key="ListBackgroundBrush" Color="#080E08"/>
    <SolidColorBrush x:Key="RowBackgroundBrush" Color="#0C140C"/>
    <SolidColorBrush x:Key="AlternatingRowBackgroundBrush" Color="#080E08"/>
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="#0C140C"/>
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#142014"/>
    <SolidColorBrush x:Key="SettingsTabBackgroundBrush" Color="#050805"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#33FF66"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#22AA44"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#1A6633"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#000000"/>
    <SolidColorBrush x:Key="ComboGlyphBrush" Color="#33FF66"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#1A6633"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#0E2A14"/>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#33FF66"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#0E2A14"/>
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#66FF99"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#0E2A14"/>
    <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="#020402"/>
    <SolidColorBrush x:Key="ScrollBarForegroundBrush" Color="#33FF66"/>

    <SolidColorBrush x:Key="NavHoverBackgroundBrush" Color="#0A2A10"/>
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#0E3A18"/>
    <SolidColorBrush x:Key="NavActiveForegroundBrush" Color="#66FF99"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#33FF66"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#AAFF33"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF3333"/>
    <SolidColorBrush x:Key="HighlightItemBrush" Color="#142014"/>
    <SolidColorBrush x:Key="ButtonHighlightBrush" Color="#4433FF66"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#661AFF33"/>

    <SolidColorBrush x:Key="PanelBrush" Color="#050805"/>
    <SolidColorBrush x:Key="CardBrush" Color="#0A100A"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#1A6633"/>
</ResourceDictionary>
