<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="AppHeadingFontFamily">Segoe UI Light, Segoe UI</FontFamily>

    <Color x:Key="AccentColor">#4FC3F7</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#4FC3F7"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#81D4FA"/>
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#29B6F6"/>
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="#0288D1"/>
    <SolidColorBrush x:Key="AccentSelectedDeepBrush" Color="#0A2030"/>
    <SolidColorBrush x:Key="AccentSelectedForegroundBrush" Color="#E1F5FE"/>
    <SolidColorBrush x:Key="AccentTabBrush" Color="#0288D1"/>
    <SolidColorBrush x:Key="AccentTabBorderBrush" Color="#81D4FA"/>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0A1218"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0E1820"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0C161E"/>
    <SolidColorBrush x:Key="SidebarBackgroundEndBrush" Color="#102028"/>
    <LinearGradientBrush x:Key="TitleBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#162830" Offset="0"/>
        <GradientStop Color="#0C161E" Offset="0.48"/>
        <GradientStop Color="#081018" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TitleBarHighlightBrush" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarDividerBrush" Color="#203040"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#142028"/>
    <SolidColorBrush x:Key="ElevatedBackgroundBrush" Color="#1A2830"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#162430"/>
    <SolidColorBrush x:Key="InputAltBackgroundBrush" Color="#121E28"/>
    <SolidColorBrush x:Key="ComboBackgroundBrush" Color="#162430"/>
    <SolidColorBrush x:Key="ComboGlyphBackgroundBrush" Color="#1E3040"/>
    <SolidColorBrush x:Key="ListBackgroundBrush" Color="#101C24"/>
    <SolidColorBrush x:Key="RowBackgroundBrush" Color="#162430"/>
    <SolidColorBrush x:Key="AlternatingRowBackgroundBrush" Color="#121E28"/>
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="#162430"/>
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#1E3040"/>
    <SolidColorBrush x:Key="SettingsTabBackgroundBrush" Color="#0E1820"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8F4F8"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8C8D8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7898A8"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#0A1218"/>
    <SolidColorBrush x:Key="ComboGlyphBrush" Color="#81D4FA"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#2A4050"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#203040"/>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#4FC3F7"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#1A3040"/>
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#81D4FA"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#203040"/>
    <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="#0C161E"/>
    <SolidColorBrush x:Key="ScrollBarForegroundBrush" Color="#4FC3F7"/>

    <SolidColorBrush x:Key="NavHoverBackgroundBrush" Color="#0A2030"/>
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#0E3040"/>
    <SolidColorBrush x:Key="NavActiveForegroundBrush" Color="#81D4FA"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#66BB6A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFCA28"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF5350"/>
    <SolidColorBrush x:Key="HighlightItemBrush" Color="#1E3040"/>

    <SolidColorBrush x:Key="PanelBrush" Color="#0E1820"/>
    <SolidColorBrush x:Key="CardBrush" Color="#142028"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#7898A8"/>
</ResourceDictionary>
