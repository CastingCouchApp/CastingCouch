<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="AppHeadingFontFamily">Bahnschrift, Segoe UI Semibold, Segoe UI</FontFamily>

    <Color x:Key="AccentColor">#5CDB6A</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#5CDB6A"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8AFF96"/>
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#2EE6C5"/>
    <SolidColorBrush x:Key="AccentSelectedBrush" Color="#3AA84A"/>
    <SolidColorBrush x:Key="AccentSelectedDeepBrush" Color="#0A2418"/>
    <SolidColorBrush x:Key="AccentSelectedForegroundBrush" Color="#EAF6FF"/>
    <SolidColorBrush x:Key="AccentTabBrush" Color="#3AA84A"/>
    <SolidColorBrush x:Key="AccentTabBorderBrush" Color="#8AFF96"/>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#060B14"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0A1220"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#081018"/>
    <SolidColorBrush x:Key="SidebarBackgroundEndBrush" Color="#0C1A18"/>
    <LinearGradientBrush x:Key="TitleBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#12241C" Offset="0"/>
        <GradientStop Color="#0A1220" Offset="0.48"/>
        <GradientStop Color="#060B14" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TitleBarHighlightBrush" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarDividerBrush" Color="#1A3040"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#101C2C"/>
    <SolidColorBrush x:Key="ElevatedBackgroundBrush" Color="#162430"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#122028"/>
    <SolidColorBrush x:Key="InputAltBackgroundBrush" Color="#0E1824"/>
    <SolidColorBrush x:Key="ComboBackgroundBrush" Color="#122028"/>
    <SolidColorBrush x:Key="ComboGlyphBackgroundBrush" Color="#1A3040"/>
    <SolidColorBrush x:Key="ListBackgroundBrush" Color="#0C1824"/>
    <SolidColorBrush x:Key="RowBackgroundBrush" Color="#122028"/>
    <SolidColorBrush x:Key="AlternatingRowBackgroundBrush" Color="#0E1824"/>
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="#122028"/>
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#1A3040"/>
    <SolidColorBrush x:Key="SettingsTabBackgroundBrush" Color="#0A1220"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EAF6FF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9EC4D8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6E94A8"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#060B14"/>
    <SolidColorBrush x:Key="ComboGlyphBrush" Color="#8AFF96"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#2A4050"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1A3040"/>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#2EE6C5"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#142830"/>
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#8AFF96"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#1A3040"/>
    <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="#081018"/>
    <SolidColorBrush x:Key="ScrollBarForegroundBrush" Color="#2EE6C5"/>

    <SolidColorBrush x:Key="NavHoverBackgroundBrush" Color="#0A2418"/>
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#123020"/>
    <SolidColorBrush x:Key="NavActiveForegroundBrush" Color="#8AFF96"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E8B84A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="HighlightItemBrush" Color="#1A3040"/>
    <SolidColorBrush x:Key="ButtonHighlightBrush" Color="#445CDB6A"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#66E8B84A"/>

    <SolidColorBrush x:Key="PanelBrush" Color="#0A1220"/>
    <SolidColorBrush x:Key="CardBrush" Color="#101C2C"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6E94A8"/>
</ResourceDictionary>
