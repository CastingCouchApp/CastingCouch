<UserControl x:Class="CreatorControlSuite.App.Views.Pages.Profiles.ProfilesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Komplette Konfigurationen für RP, Just Chatting, Reactions und weitere Stream-Arten."
                       Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Gespeicherte Profile" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             DisplayMemberPath="Name"
                             Background="{DynamicResource WindowBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="16,0,0,0">
                <StackPanel>
                    <TextBlock Text="Profil bearbeiten" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                    <TextBlock Text="Name" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Beschreibung" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="90" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <WrapPanel Grid.Row="2">
            <Button Content="Aktuelle Einstellungen als Profil speichern"
                    Command="{Binding CreateCommand}"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource TextOnAccentBrush}"
                    FontWeight="Bold"/>
            <Button Content="Profil anwenden" Command="{Binding ApplyCommand}"/>
            <Button Content="Exportieren" Command="{Binding ExportCommand}"/>
            <Button Content="Importieren" Command="{Binding ImportCommand}"/>
            <Button Content="Löschen" Command="{Binding DeleteCommand}" Background="#7A3838"/>
        </WrapPanel>
    </Grid>
</UserControl>
