<UserControl x:Class="CreatorControlSuite.App.Views.Pages.Dashboard.DashboardPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CreatorControlSuite.App"
             xmlns:twitch="clr-namespace:CreatorControlSuite.App.Twitch"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <local:TwitchRoleToBrushConverter x:Key="TwitchRoleToBrushConverter"/>
    </UserControl.Resources>
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Brand mark lives in the shell title bar (CastingCouch). -->
                <Grid Margin="0,0,0,14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dashboard" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Dein Streaming Command Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="DashboardHeaderStopStreamButtonLegacy" x:FieldModifier="public" Content="■  STREAM BEENDEN" Style="{StaticResource OrangeActionButtonStyle}" Margin="0,0,8,0" Padding="18,11"/>
                        <Button x:Name="DashboardEditLayoutButton" x:FieldModifier="public" Content="⚙  LAYOUT" Padding="14,11" Margin="0,0,6,0"/>
                        <Button x:Name="DashboardRestoreHiddenModulesButton" x:FieldModifier="public" Content="MODULE" Padding="14,11" Margin="0"/>
                        <ComboBox x:Name="DashboardQuickPresetBox" x:FieldModifier="public" Visibility="Collapsed">
                            <ComboBoxItem Content="Command Center"/>
                        </ComboBox>
                        <Button x:Name="DashboardQuickApplyPresetButton" x:FieldModifier="public" Visibility="Collapsed" Content="PRESET"/>
                        <Button x:Name="DashboardFocusModeButton" x:FieldModifier="public" Visibility="Collapsed" Content="FOKUSMODUS"/>
                        <ComboBox x:Name="DashboardDirectSizeBox" x:FieldModifier="public" Visibility="Collapsed"/>
                        <Button x:Name="DashboardDirectApplySizeButton" x:FieldModifier="public" Visibility="Collapsed" Content="GRÖSSE"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ClipToBounds="True">
                    <Grid x:Name="DashboardScrollRoot" x:FieldModifier="public" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid x:Name="DashboardContentStack" x:FieldModifier="public" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0">
                             <Grid.RowDefinitions>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="Auto"/>
                                 <RowDefinition Height="*"/>
                                 <RowDefinition Height="Auto"/>
                             </Grid.RowDefinitions>
                            <Border x:Name="DashboardTwitchChannelWidget" x:FieldModifier="public"
                                    Grid.Row="0"
                                    Margin="0,0,0,12"
                                    Padding="14,10"
                                    Background="{DynamicResource ElevatedBackgroundBrush}"
                                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Cursor="Hand"
                                    ToolTip="Streamtitel, Kategorie und Live-Benachrichtigung bearbeiten">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="8" Background="#9146FF" Margin="0,0,12,0">
                                        <TextBlock Text="T" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="TWITCH-KANAL" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DashboardTwitchChannelTitleText" x:FieldModifier="public" Text="Kein Streamtitel gesetzt" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0">
                                        <TextBlock Text="KATEGORIE · LIVE-BENACHRICHTIGUNG" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                        <TextBlock x:Name="DashboardTwitchChannelDetailsText" x:FieldModifier="public" Text="- · nicht gesetzt" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="BEARBEITEN  ›" Foreground="{DynamicResource AccentSelectedForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" x:Name="DashboardStreamControlModule" x:FieldModifier="public" Margin="0,0,0,12" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                             <StackPanel>
                                                <TextBlock Text="SCHNELLZUGRIFF" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16"/>
                                                <UniformGrid Columns="6" Rows="1" Margin="0,12,0,8">
                                                    <Button x:Name="DashboardPrepareStreamButton" x:FieldModifier="public" ToolTip="Konfigurierte Streaming-Dienste starten und den Stream vorbereiten" MinHeight="48" MinWidth="0" HorizontalContentAlignment="Center" Content="🚀  STREAM VORBEREITEN" Style="{StaticResource OrangeActionButtonStyle}" FontWeight="Bold" Margin="3" Padding="8,4"/>
                                                    <Button x:Name="DashboardObsStartStreamButton" x:FieldModifier="public" ToolTip="OBS-Stream starten" MinHeight="48" MinWidth="0" HorizontalContentAlignment="Center" Content="▷  STREAM STARTEN" FontWeight="Bold" Margin="3" Padding="8,4"/>
                                                    <Button x:Name="DashboardObsStopStreamButton" x:FieldModifier="public" Content="■  STREAM BEENDEN" MinHeight="48" MinWidth="0" HorizontalContentAlignment="Center" Margin="3" Padding="8,4"/>
                                                    <Button x:Name="DashboardQuickAccessAlertButton" x:FieldModifier="public" ToolTip="Einen Test-Alert auslösen" MinHeight="48" MinWidth="0" HorizontalContentAlignment="Center" Content="♧  TEST-ALERT" Margin="3" Padding="8,4"/>
                                                    <Button x:Name="DashboardQuickAccessOverlayButton" x:FieldModifier="public" ToolTip="Overlay-Einstellungen öffnen" MinHeight="48" MinWidth="0" HorizontalContentAlignment="Center" Content="▱  OVERLAY EIN/AUS" Margin="3" Padding="8,4"/>
                                                    <Button x:Name="DashboardShortStreamTestButton" x:FieldModifier="public" ToolTip="Automatisierung öffnen und einen kurzen Testlauf ohne Stream starten" MinHeight="48" MinWidth="0" HorizontalContentAlignment="Center" Content="⚙  STREAM-KURZTEST" Margin="3" Padding="8,4"/>
                                                </UniformGrid>
                                                <Border x:Name="DashboardPrepareProgressPanel" x:FieldModifier="public" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="3,2,3,10" Visibility="Collapsed">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="STREAM WIRD VORBEREITET" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                            <TextBlock x:Name="DashboardPrepareProgressPercentText" x:FieldModifier="public" Grid.Column="1" Text="0 %" Foreground="{DynamicResource AccentHoverBrush}" FontWeight="Bold"/>
                                                        </Grid>
                                                        <ProgressBar x:Name="DashboardPrepareProgressBar" x:FieldModifier="public" Minimum="0" Maximum="100" Value="0" Height="12" Margin="0,8,0,0"/>
                                                        <TextBlock x:Name="DashboardPrepareProgressText" x:FieldModifier="public" Text="Programme werden gestartet …" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="Streamtitel" Visibility="Collapsed"/>
                                                <Grid Visibility="Collapsed">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="DashboardTwitchTitleBox" x:FieldModifier="public"/>
                                                    <Button x:Name="DashboardSaveTwitchChannelButton" x:FieldModifier="public" Grid.Column="1" Content="Titel/Kategorie ändern" Margin="8,0,0,0"/>
                                                </Grid>
                                                <Grid Margin="0,8,0,0" Visibility="Collapsed">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="DashboardTwitchCategorySearchBox" x:FieldModifier="public" ToolTip="Kategorie suchen"/>
                                                    <Button x:Name="DashboardSearchTwitchCategoryButton" x:FieldModifier="public" Grid.Column="1" Content="Suchen" Margin="8,0"/>
                                                    <ComboBox x:Name="DashboardTwitchCategoryResultsBox" x:FieldModifier="public" Grid.Column="2" DisplayMemberPath="Name" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Grid>
                                                <Border x:Name="DashboardRaidControlModule" x:FieldModifier="public" Visibility="Collapsed"/>
                                                <!-- Kompatibilität: Streamende-Controls (UI läuft über StreamEndDialogWindow) -->
                                                <StackPanel Visibility="Collapsed" IsHitTestVisible="False">
                                                    <Border x:Name="DashboardStreamEndModule" x:FieldModifier="public"/>
                                                    <Button x:Name="DashboardStreamEndToggleButton" x:FieldModifier="public"/>
                                                    <TextBlock x:Name="DashboardStreamEndExpandGlyph" x:FieldModifier="public"/>
                                                    <TextBlock x:Name="DashboardStreamEndStatusText" x:FieldModifier="public" Text="Bereit"/>
                                                    <StackPanel x:Name="DashboardStreamEndContentPanel" x:FieldModifier="public"/>
                                                    <TextBlock x:Name="DashboardStreamEndTargetText" x:FieldModifier="public"/>
                                                    <CheckBox x:Name="DashboardRaidEnabledBox" x:FieldModifier="public"/>
                                                    <TextBlock x:Name="DashboardRaidTargetStatusText" x:FieldModifier="public"/>
                                                    <Grid x:Name="DashboardRaidSelectionPanel" x:FieldModifier="public"/>
                                                    <ComboBox x:Name="DashboardRaidChannelBox" x:FieldModifier="public"/>
                                                    <Button x:Name="DashboardOpenRaidChannelButton" x:FieldModifier="public"/>
                                                    <TextBox x:Name="DashboardPlannedStreamEndSecondsBox" x:FieldModifier="public"/>
                                                    <Button x:Name="DashboardPlanStreamEndButton" x:FieldModifier="public"/>
                                                    <Button x:Name="DashboardCancelPlannedStreamEndButton" x:FieldModifier="public"/>
                                                    <TextBlock x:Name="DashboardStreamEndCountdownLabel" x:FieldModifier="public"/>
                                                    <TextBlock x:Name="DashboardStreamEndCountdownText" x:FieldModifier="public" Text="—"/>
                                                    <ProgressBar x:Name="DashboardStreamEndCountdownProgress" x:FieldModifier="public" Minimum="0" Maximum="1" Value="0"/>
                                                    <Border x:Name="DashboardRaidStatusPanel" x:FieldModifier="public"/>
                                                    <TextBlock x:Name="DashboardRaidCountdownTitleText" x:FieldModifier="public"/>
                                                    <TextBlock x:Name="DashboardRaidCountdownTargetText" x:FieldModifier="public"/>
                                                    <TextBlock x:Name="DashboardRaidCountdownText" x:FieldModifier="public"/>
                                                    <TextBlock x:Name="DashboardRaidViewerText" x:FieldModifier="public"/>
                                                    <ProgressBar x:Name="DashboardRaidCountdownProgress" x:FieldModifier="public" Minimum="0" Maximum="90" Value="0"/>
                                                    <Button x:Name="DashboardStartRaidButton" x:FieldModifier="public"/>
                                                    <Button x:Name="DashboardCancelRaidButton" x:FieldModifier="public"/>
                                                    <Button x:Name="DashboardSkipRaidAndStopButton" x:FieldModifier="public"/>
                                                </StackPanel>
                                             </StackPanel>
                            </Border>
                            <Grid x:Name="DashboardPrimaryRow" x:FieldModifier="public" Grid.Row="2" Margin="0" VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <!-- Normal: Content in Zeile 0 (*); Groß-Vorschau: Content in Zeile 1 (*), gesetzt per Code -->
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="0"/>
                                    <ColumnDefinition Width="*" MinWidth="280"/>
                                </Grid.ColumnDefinitions>
                                    <Grid x:Name="DashboardObsSceneColumn" x:FieldModifier="public" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Stretch" HorizontalAlignment="Left">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*" MinHeight="120"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" x:Name="DashboardObsSceneControlModule" x:FieldModifier="public" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <StackPanel x:Name="DashboardObsSceneControlContent" x:FieldModifier="public" MaxWidth="400">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="AKTUELLE SZENE (OBS)" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <ComboBox x:Name="DashboardObsScenePreviewSizeBox" x:FieldModifier="public" Grid.Column="1" MinWidth="100" VerticalAlignment="Center" SelectedIndex="1" ToolTip="Vorschau-Größe">
                                                        <ComboBoxItem Content="Kompakt" Tag="Kompakt"/>
                                                        <ComboBoxItem Content="Standard" Tag="Standard"/>
                                                        <ComboBoxItem Content="Groß" Tag="Groß"/>
                                                    </ComboBox>
                                                </Grid>
                                                <Border x:Name="DashboardObsScenePreviewBorder" x:FieldModifier="public" Width="400" Height="225" MinWidth="400" MinHeight="225" MaxWidth="400" MaxHeight="225" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" ClipToBounds="True" HorizontalAlignment="Left">
                                                    <Grid>
                                                        <Rectangle Fill="{DynamicResource PanelBackgroundBrush}"/>
                                                        <Image x:Name="DashboardObsScenePreviewImage" x:FieldModifier="public" Stretch="Uniform"/>
                                                        <Border x:Name="DashboardObsScenePreviewPlaceholder" x:FieldModifier="public" Background="{DynamicResource WindowBackgroundBrush}">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="OBS" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="Vorschau wird nach der OBS-Verbindung geladen" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="#A0000000" VerticalAlignment="Bottom" Padding="8,4">
                                                            <TextBlock x:Name="DashboardCurrentSceneText" x:FieldModifier="public" Text="AKTUELLE SZENE" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <WrapPanel x:Name="DashboardSceneButtonsPanel" x:FieldModifier="public" MaxWidth="400"/>
                                                <Button x:Name="DashboardAddSceneButton" x:FieldModifier="public" Content="+ Button hinzufügen" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,6"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="DashboardTwitchUsersModule" x:FieldModifier="public" Grid.Row="1" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,8,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" MinWidth="0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="DashboardTwitchUsersHeaderText" x:FieldModifier="public" Text="TWITCH · USER (0)" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                <ListBox x:Name="DashboardTwitchUsersList" x:FieldModifier="public" Grid.Row="1" Margin="0,8,0,0" Background="{DynamicResource ListBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            <Setter Property="Focusable" Value="False"/>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Foreground="{Binding Converter={StaticResource TwitchRoleToBrushConverter}}" TextWrapping="Wrap" Margin="4,2"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                     <Grid x:Name="DashboardPrimaryContentColumn" x:FieldModifier="public" Grid.Column="1" VerticalAlignment="Stretch">
                                         <Grid Margin="0,0,0,0" VerticalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" x:Name="DashboardTwitchEventsModule" x:FieldModifier="public" Margin="0,0,4,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="LETZTE EVENTS" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                        <Button x:Name="DashboardJoinStreamTogetherButton" x:FieldModifier="public" Grid.Column="1" Content="STREAM TOGETHER" Padding="8,4" ToolTip="Stream Together in Twitch öffnen und Einladungen verwalten" Visibility="Collapsed"/>
                                                    </Grid>
                                                    <ListBox x:Name="DashboardTwitchEventsList" x:FieldModifier="public" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1" Margin="0,8,0,0" Background="{DynamicResource ListBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Stretch" Focusable="False">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="Padding" Value="8,6"/>
                                                                <Setter Property="Margin" Value="2"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                <Setter Property="Focusable" Value="False"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                    </ListBox>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Column="1" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" x:Name="DashboardTwitchChatModule" x:FieldModifier="public" Margin="4,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition x:Name="DashboardTwitchChatHeaderRow" x:FieldModifier="public" Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition x:Name="DashboardTwitchChatControlsRow" x:FieldModifier="public" Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <DockPanel x:Name="DashboardTwitchChatHeader" x:FieldModifier="public">
                                                        <TextBlock Text="CHAT (TWITCH)" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16"/>
                                                        <TextBlock Text="LIVE" Foreground="#9B5CFF" HorizontalAlignment="Right"/>
                                                    </DockPanel>
                                                    <Grid x:Name="DashboardTwitchChatContentHost" x:FieldModifier="public" Grid.Row="1" Margin="0,8,0,8">
                                                        <ListBox x:Name="DashboardTwitchChatList" x:FieldModifier="public" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource ListBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" VerticalAlignment="Stretch" Focusable="False">
                                                            <ListBox.ItemContainerStyle>
                                                                <Style TargetType="ListBoxItem">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                    <Setter Property="Padding" Value="0"/>
                                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                    <Setter Property="Focusable" Value="False"/>
                                                                </Style>
                                                            </ListBox.ItemContainerStyle>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <twitch:TwitchChatTextBlock ChatItem="{Binding}" Foreground="{Binding Converter={StaticResource TwitchRoleToBrushConverter}}" TextWrapping="Wrap" Margin="3,2"/>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <wv2:WebView2 x:Name="DashboardTwitchWebChat" x:FieldModifier="public"
                                                                      Visibility="Collapsed"
                                                                      DefaultBackgroundColor="Transparent"/>
                                                    </Grid>
                                                    <StackPanel x:Name="DashboardTwitchChatControls" x:FieldModifier="public" Grid.Row="2">
                                                        <Grid x:Name="DashboardTwitchBuiltInSendRow" x:FieldModifier="public">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="DashboardTwitchChatMessageBox" x:FieldModifier="public"/>
                                                            <Button x:Name="DashboardSendTwitchChatButton" x:FieldModifier="public" Grid.Column="1" Content="SENDEN" Margin="8,0,0,0"/>
                                                            <Button x:Name="DashboardOpenTwitchChatButton" x:FieldModifier="public" Grid.Column="2" Content="CHAT ÖFFNEN" Margin="8,0,0,0"/>
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <TextBox x:Name="DashboardModerationUserBox" x:FieldModifier="public" Width="150" ToolTip="Benutzername"/>
                                                            <Button x:Name="DashboardTimeoutUserButton" x:FieldModifier="public" Content="TIMEOUT 10 MIN" Margin="8,0,0,0"/>
                                                            <Button x:Name="DashboardBanUserButton" x:FieldModifier="public" Content="BANNEN" Margin="8,0,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                            </Grid>
                            <!-- Entfernte Dashboard-Widgets (Kompatibilität für Code-Behind) -->
                            <Grid Grid.Row="3" Visibility="Collapsed">
                                <Grid x:Name="DashboardStreamingServicesRow" x:FieldModifier="public"/>
                                <Grid x:Name="DashboardRemainingWidgetsRow" x:FieldModifier="public">
                                    <Border x:Name="DashboardNextAutomationModule" x:FieldModifier="public">
                                        <StackPanel>
                                            <ListBox x:Name="DashboardAutomationList" x:FieldModifier="public"/>
                                            <Button x:Name="DashboardManageAutomationsButton" x:FieldModifier="public" Content="AUTOMATISIERUNGEN VERWALTEN"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="DashboardSystemResourcesModule" x:FieldModifier="public">
                                        <StackPanel>
                                            <TextBlock x:Name="DashboardCpuText" x:FieldModifier="public" Text="CPU: –"/>
                                            <ProgressBar x:Name="DashboardCpuBar" x:FieldModifier="public" Minimum="0" Maximum="100"/>
                                            <TextBlock x:Name="DashboardRamText" x:FieldModifier="public" Text="RAM: –"/>
                                            <ProgressBar x:Name="DashboardRamBar" x:FieldModifier="public" Minimum="0" Maximum="100"/>
                                            <Button x:Name="DashboardOpenDiagnosticsButton" x:FieldModifier="public" Content="DETAILS ANZEIGEN"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <!-- Unsichtbarer Kompatibilitätsbereich für bestehende Eventhandler -->
                                <Grid>
                                    <Border Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" x:Name="DashboardLiveEventsModule" x:FieldModifier="public" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="DashboardSelectedStatisticLabel" x:FieldModifier="public" Text="ZUSCHAUERZAHL"/>
                                            <TextBlock x:Name="DashboardSelectedStatisticValue" x:FieldModifier="public" Text="0"/>
