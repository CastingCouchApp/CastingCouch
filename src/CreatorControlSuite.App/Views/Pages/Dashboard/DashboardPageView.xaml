                                        <TextBlock Text="Schnellzugriff auf die bestehenden Spezialbereiche." Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,10"/>
                                        <UniformGrid Columns="2">
                                            <Button x:Name="DashboardOpenServicesAdvancedButton" x:FieldModifier="public" Content="DIENSTE" Margin="3"/>
                                            <Button x:Name="DashboardOpenDiagnosticsAdvancedButton" x:FieldModifier="public" Content="DIAGNOSE" Margin="3"/>
                                            <Button x:Name="DashboardOpenSettingsAdvancedButton" x:FieldModifier="public" Content="EINSTELLUNGEN" Margin="3"/>
                                            <Button x:Name="DashboardOpenProfilesAdvancedButton" x:FieldModifier="public" Content="PROFILE" Margin="3"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border x:Name="DashboardStreamHistorySection" x:FieldModifier="public" Visibility="Collapsed" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="3,0,3,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock Text="STREAM-HISTORIE" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="lokal gespeichert" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ListBox x:Name="DashboardStreamHistoryList" x:FieldModifier="public" Grid.Row="1" Height="150" Margin="0,10,0,8" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="DashboardRefreshHistoryButton" x:FieldModifier="public" Content="AKTUALISIEREN" Margin="4,0"/>
                                        <Button x:Name="DashboardOpenHistoryFolderButton" x:FieldModifier="public" Content="ORDNER ÖFFNEN" Margin="4,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
    </Grid>
</UserControl>
