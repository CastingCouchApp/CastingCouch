<UserControl x:Class="CreatorControlSuite.App.Views.Pages.Spotify.SpotifyAutomationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Während Alerts" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="Die Lautstärke wird auf ein festes Level zwischen 0 und 100 gesetzt und nach dem Alert wiederhergestellt."
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,5,0,0"/>
        <CheckBox IsChecked="{Binding MuteDuringAlerts}"
                  Content="Spotify-Lautstärke bei Alerts anpassen"
                  Margin="0,12,0,0"
                  Click="AutoSave_OnChanged"/>
        <Grid Margin="22,10,0,0" Width="430" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Ziel-Level" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     Text="{Binding AlertVolume, UpdateSourceTrigger=PropertyChanged}"
                     Width="76"
                     ToolTip="Absolutes Lautstärke-Level von 0 bis 100"
                     LostFocus="AutoSave_OnChanged"/>
            <TextBlock Grid.Column="2"
                       Text="0–100"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center"
                       Margin="7,0,0,0"/>
        </Grid>
        <CheckBox IsChecked="{Binding FadeDuringAlerts}"
                  Content="Level weich ein- und ausblenden"
                  Margin="22,9,0,0"
                  Click="AutoSave_OnChanged"/>
        <Grid Margin="44,8,0,0" Width="430" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="146"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Absenken in" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     Text="{Binding AlertFadeOutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                     Width="70"
                     LostFocus="AutoSave_OnChanged"/>
            <TextBlock Grid.Column="2"
                       Text="ms · zurück in"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="3"
                     Text="{Binding AlertFadeInMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                     Width="70"
                     LostFocus="AutoSave_OnChanged"/>
        </Grid>
        <TextBlock Text="Beispiel: Ziel-Level 50 setzt Spotify während eines Alerts auf 50 – unabhängig davon, ob vorher Level 70 oder 90 aktiv war."
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap"
                   Margin="22,8,0,0"/>
        <TextBlock Text="{Binding AlertStatusText}" Margin="22,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AlertStatusState}" Value="Warning">
                            <Setter Property="Foreground" Value="Orange"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AlertStatusState}" Value="Error">
                            <Setter Property="Foreground" Value="IndianRed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AlertStatusState}" Value="Success">
                            <Setter Property="Foreground" Value="LightGreen"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Button Content="ALERT-EINSTELLUNGEN SPEICHERN"
                Command="{Binding SaveCommand}"
                HorizontalAlignment="Left"
                Margin="0,14,0,0"/>
        <TextBlock Text="{Binding AutomationStatusText}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,7,0,0"/>
    </StackPanel>
</UserControl>
