<UserControl x:Class="CreatorControlSuite.App.Views.Pages.Services.SpotifyServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:spotify="clr-namespace:CreatorControlSuite.App.Views.Pages.Spotify">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <StackPanel Margin="22"
                    MaxWidth="1120"
                    HorizontalAlignment="Left"
                    Style="{StaticResource CCSDarkSettingsContentStyle}">
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Spotify" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Wiedergabe, Geräte und Musikautomatik an einem Ort."
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Border x:Name="ServicesSpotifyInactiveBanner"
                    x:FieldModifier="public"
                    Background="{DynamicResource InputAltBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Spotify ist nicht der aktive Music-Player." FontWeight="Bold"/>
                        <TextBlock Text="Aktiviere Spotify unter Einstellungen → Music Player."
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Button x:Name="ServicesSpotifyOpenMusicSettingsButton"
                                x:FieldModifier="public"
                                Content="EINSTELLUNGEN"/>
                        <Button x:Name="ServicesSpotifyOpenPlayerButton"
                                x:FieldModifier="public"
                                Content="PLAYER ÖFFNEN"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Dashboard-nahe Now-Playing-Karte -->
            <Border Background="{DynamicResource ElevatedBackgroundBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="156"
                            Height="156"
                            CornerRadius="8"
                            Background="{DynamicResource SidebarBackgroundBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <Image x:Name="ServicesSpotifyAlbumCoverImage"
                               x:FieldModifier="public"
                               Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <DockPanel>
                            <TextBlock Text="Deine Wiedergabe"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <Button x:Name="ServicesSpotifyRefreshButton"
                                    x:FieldModifier="public"
                                    Content="AKTUALISIEREN"
                                    DockPanel.Dock="Right"
                                    Padding="10,3"/>
                        </DockPanel>
                        <TextBlock x:Name="ServicesSpotifyNowPlayingText"
                                   x:FieldModifier="public"
                                   Text="Kein Titel geladen"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,3"/>
                        <TextBlock x:Name="ServicesSpotifyAlbumText"
                                   x:FieldModifier="public"
                                   Text="Album: -"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <Slider x:Name="ServicesSpotifyProgressBar"
                                x:FieldModifier="public"
                                Minimum="0"
                                Maximum="1"
                                Value="0"
                                IsMoveToPointEnabled="True"
                                Margin="0,14,0,3"
                                ToolTip="Im aktuellen Titel vor- oder zurückspringen"/>
                        <Grid>
                            <TextBlock x:Name="ServicesSpotifyProgressText"
                                       x:FieldModifier="public"
                                       Text="00:00"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="ServicesSpotifyDurationText"
                                       x:FieldModifier="public"
                                       Text="00:00"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel>
                                <Button x:Name="ServicesSpotifyPreviousButton" x:FieldModifier="public" Content="⏮ ZURÜCK"/>
                                <Button x:Name="ServicesSpotifyPlayButton" x:FieldModifier="public" Content="▶ PLAY" Background="{DynamicResource AccentBrush}"/>
                                <Button x:Name="ServicesSpotifyPauseButton" x:FieldModifier="public" Content="⏸ PAUSE"/>
                                <Button x:Name="ServicesSpotifyNextButton" x:FieldModifier="public" Content="WEITER ⏭"/>
                                <Button x:Name="ServicesSpotifyShuffleButton" x:FieldModifier="public" Content="SHUFFLE: AUS"/>
                            </WrapPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="Lautstärke" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                <Slider x:Name="ServicesSpotifyVolumeSlider"
                                        x:FieldModifier="public"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="100"
                                        Width="150"
                                        Margin="10,0,8,0"/>
                                <TextBlock x:Name="ServicesSpotifyVolumeText"
                                           x:FieldModifier="public"
                                           Text="100 %"
                                           MinWidth="42"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="ServicesSpotifyLaunchButton"
                                    x:FieldModifier="public"
                                    Grid.Column="2"
                                    Content="SPOTIFY STARTEN"/>
                        </Grid>
                        <Button x:Name="ServicesSpotifyRepeatButton"
                                x:FieldModifier="public"
                                Content="Wiederholung: Aus"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Gerät -->
            <Border Background="{DynamicResource ElevatedBackgroundBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Wiedergabegerät" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Wähle das Gerät, das die Suite für Spotify-Aktionen verwenden soll."
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,4,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ServicesSpotifyDeviceBox"
                                  x:FieldModifier="public"
                                  DisplayMemberPath="Name"
                                  MinWidth="360"/>
                        <Button x:Name="ServicesSpotifySetPreferredDeviceButton"
                                x:FieldModifier="public"
                                Grid.Column="1"
                                Content="AUSWAHL SPEICHERN"
                                Margin="8,0,0,0"
                                Background="{DynamicResource AccentBrush}"/>
                        <Button x:Name="ServicesSpotifyRefreshDevicesButton"
                                x:FieldModifier="public"
                                Grid.Column="2"
                                Content="NEU LADEN"
                                Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock x:Name="ServicesSpotifyDeviceStatusText"
                               x:FieldModifier="public"
                               Text="Kein Gerät ausgewählt."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,7,0,0"
                               TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="ServicesSpotifyTransferAndPlayDeviceButton"
                                x:FieldModifier="public"
                                Content="AUF AUSWAHL ABSPIELEN"/>
                        <Button x:Name="ServicesSpotifyTransferDeviceButton"
                                x:FieldModifier="public"
                                Content="WIEDERGABE ÜBERTRAGEN"/>
                        <Button x:Name="ServicesSpotifyActivatePreferredDeviceButton"
                                x:FieldModifier="public"
                                Content="GESPEICHERTES GERÄT AKTIVIEREN"/>
                    </WrapPanel>
                    <CheckBox x:Name="ServicesSpotifyAutoTransferPreferredBox"
                              x:FieldModifier="public"
                              Content="Gespeichertes Gerät vor Spotify-Aktionen automatisch aktivieren"
                              Margin="0,10,0,0"/>
                    <CheckBox x:Name="ServicesSpotifyUseActiveFallbackBox"
                              x:FieldModifier="public"
                              Content="Aktives Gerät verwenden, wenn das gespeicherte Gerät nicht erreichbar ist"
                              Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Start, Alerts und Szenen -->
            <Border Background="{DynamicResource ElevatedBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,16,0,0">
                <StackPanel>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="Stream- und Szenenautomatik" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Startplaylist, Alert-Lautstärke und Regeln für jede OBS-Szene."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ServicesSpotifyAutomationStatusText"
                                   x:FieldModifier="public"
                                   Text="Deaktiviert"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Background="{DynamicResource InputAltBackgroundBrush}"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,14,0,0">
                        <spotify:SpotifyAutomationView x:Name="SpotifyAutomationViewHost"
                                                       x:FieldModifier="public"/>
                    </Border>
                    <Separator Margin="0,16,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Musik pro OBS-Szene" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Für jede vorhandene Szene: Playlist, Shuffle, Lautstärke und Fade festlegen."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="ServicesSpotifyEditSceneMusicButton"
                                x:FieldModifier="public"
                                Grid.Column="1"
                                Content="MUSIK PRO OBS-SZENE EINRICHTEN"
                                Background="{DynamicResource AccentBrush}"
                                Padding="16,9"
                                Margin="18,0,0,0"/>
                    </Grid>
                    <CheckBox x:Name="ServicesSpotifySmartAutomationBox"
                              x:FieldModifier="public"
                              Content="Szenenregeln aktivieren"
                              Margin="0,12,0,0"/>
                    <TextBlock Text="Eingerichtete Szenen" FontWeight="SemiBold" Margin="0,12,0,5"/>
                    <ListBox x:Name="ServicesSpotifyAutomationRulesList"
                             x:FieldModifier="public"
                             MinHeight="54"
                             MaxHeight="150"
                             Background="{DynamicResource SidebarBackgroundBrush}"
                             BorderBrush="{DynamicResource SubtleBorderBrush}"/>
                    <Expander Header="Diagnose und Protokoll" Margin="0,12,0,0">
                        <StackPanel Margin="0,10,0,0">
                            <CheckBox x:Name="ServicesSpotifyHealthMonitorBox"
                                      x:FieldModifier="public"
                                      Content="Spotify-Verbindung überwachen"/>
                            <CheckBox x:Name="ServicesSpotifyAutoRecoverBox"
                                      x:FieldModifier="public"
                                      Content="Nicht erreichbares Wiedergabegerät automatisch wiederherstellen"
                                      Margin="0,5,0,0"/>
                            <TextBlock x:Name="ServicesSpotifyHealthStatusText"
                                       x:FieldModifier="public"
                                       Text="Noch nicht geprüft"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,6,0,8"/>
                            <WrapPanel>
                                <Button x:Name="ServicesSpotifyTestAutomationButton" x:FieldModifier="public" Content="AKTUELLE SZENE TESTEN"/>
                                <Button x:Name="ServicesSpotifyCreateDefaultRulesButton" x:FieldModifier="public" Content="STANDARDREGELN"/>
                                <Button x:Name="ServicesSpotifyClearAutomationLogButton" x:FieldModifier="public" Content="PROTOKOLL LEEREN"/>
                            </WrapPanel>
                            <ListBox x:Name="ServicesSpotifyAutomationLogList"
                                     x:FieldModifier="public"
                                     MaxHeight="160"
                                     Margin="0,8,0,0"
                                     Background="{DynamicResource SidebarBackgroundBrush}"
                                     BorderBrush="{DynamicResource SubtleBorderBrush}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Statistik -->
            <Border Background="{DynamicResource ElevatedBackgroundBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Hörstatistik" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ServicesSpotifyStatisticsSummaryText"
                                   x:FieldModifier="public"
                                   Text="0 erkannte Titelstarts · 00:00:00 Wiedergabezeit"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button x:Name="ServicesSpotifyOpenStatisticsButton"
                            x:FieldModifier="public"
                            Grid.Column="1"
                            Content="STATISTIK ÖFFNEN"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Overlay -->
            <Expander Header="Overlay-Verhalten"
                      IsExpanded="False"
                      Background="{DynamicResource ElevatedBackgroundBrush}"
                      BorderBrush="{DynamicResource SubtleBorderBrush}"
                      BorderThickness="1"
                      Padding="18"
                      Margin="0,16,0,0">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Bestimme, wann das Spotify-Overlay sichtbar bleibt."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <CheckBox x:Name="ServicesSpotifyHidePausedBox"
                              x:FieldModifier="public"
                              Content="Overlay bei pausierter Musik ausblenden"
                              Margin="0,12,0,0"/>
                    <CheckBox x:Name="ServicesSpotifyHideMutedBox"
                              x:FieldModifier="public"
                              Content="Overlay bei lautloser Musik ausblenden"
                              Margin="0,7,0,0"/>
                    <Border Background="{DynamicResource InputAltBackgroundBrush}"
                            CornerRadius="8"
                            Padding="12"
                            Margin="22,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Mute erkennen über" FontWeight="SemiBold"/>
                            <CheckBox x:Name="ServicesSpotifyDetectVolumeMuteBox"
                                      x:FieldModifier="public"
                                      Content="Spotify-Lautstärke"
                                      Margin="0,7,0,0"/>
                            <CheckBox x:Name="ServicesSpotifyDetectObsMuteBox"
                                      x:FieldModifier="public"
                                      Content="OBS-Audioquelle"
                                      Margin="0,6,0,0"/>
                            <ComboBox x:Name="ServicesSpotifyObsAudioSourceBox"
                                      x:FieldModifier="public"
                                      IsEditable="True"
                                      Width="360"
                                      HorizontalAlignment="Left"
                                      Margin="22,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Separator Margin="0,16,0,14"/>
                    <TextBlock Text="Overlay-Datendatei" FontWeight="SemiBold"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ServicesSpotifyDataJsonPathBox"
                                 x:FieldModifier="public"/>
                        <Button x:Name="ServicesSpotifyBrowseDataJsonButton"
                                x:FieldModifier="public"
                                Grid.Column="1"
                                Content="AUSWÄHLEN"
                                Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock x:Name="ServicesSpotifyOverlayPathText"
                               x:FieldModifier="public"
                               Text="Keine JSON-Datei ausgewählt."
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,6,0,0"/>
                    <TextBlock x:Name="ServicesSpotifyOverlayStatusText"
                               x:FieldModifier="public"
                               Text="Overlay-Verknüpfung nicht geprüft."
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="ServicesSpotifySaveOverlayButton" x:FieldModifier="public" Content="SPEICHERN"/>
                        <Button x:Name="ServicesSpotifySyncOverlayButton" x:FieldModifier="public" Content="JETZT SCHREIBEN"/>
                        <Button x:Name="ServicesSpotifyReloadOverlayButton" x:FieldModifier="public" Content="ORDNER ÖFFNEN"/>
                        <Button x:Name="ServicesSpotifyPreviewOverlayButton" x:FieldModifier="public" Content="DATEI ÖFFNEN"/>
                    </WrapPanel>
                </StackPanel>
            </Expander>

            <!--
              Diese Controls bleiben ausschließlich als interne Kompatibilitätsfelder bestehen,
              bis die alten Catalog-/Queue-Bindings aus dem Shell-Slice entfernt werden.
              Sie sind nicht Teil der Spotify-Oberfläche.
            -->
            <Grid x:Name="SpotifyLegacyCatalogControls" Visibility="Collapsed">
                <TextBox x:Name="ServicesSpotifyTrackSearchBox" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyTrackSearchButton" x:FieldModifier="public"/>
                <ListBox x:Name="ServicesSpotifyTrackSearchResultsList" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyPlaySelectedSearchResultButton" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyAddSelectedToQueueButton" x:FieldModifier="public"/>
                <TextBlock x:Name="ServicesSpotifyTrackSearchStatusText" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyRefreshQueueButton" x:FieldModifier="public"/>
                <TextBlock x:Name="ServicesSpotifyQueueCurrentText" x:FieldModifier="public"/>
                <ListBox x:Name="ServicesSpotifyQueueList" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyPlayQueueItemButton" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifySkipCurrentButton" x:FieldModifier="public"/>
                <TextBlock x:Name="ServicesSpotifyQueueStatusText" x:FieldModifier="public"/>
                <TextBlock x:Name="ServicesSpotifyQueueEmptyText" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyRefreshHistoryButton" x:FieldModifier="public"/>
                <ListBox x:Name="ServicesSpotifyHistoryList" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyPlayHistoryButton" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyQueueHistoryButton" x:FieldModifier="public"/>
                <TextBlock x:Name="ServicesSpotifyHistoryStatusText" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyRefreshSavedTracksButton" x:FieldModifier="public"/>
                <ListBox x:Name="ServicesSpotifySavedTracksList" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyPlaySavedTrackButton" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyRemoveSavedTrackButton" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyToggleCurrentSavedButton" x:FieldModifier="public"/>
                <TextBlock x:Name="ServicesSpotifySavedTracksStatusText" x:FieldModifier="public"/>
                <TextBox x:Name="ServicesSpotifyPlaylistFilterBox" x:FieldModifier="public"/>
                <ComboBox x:Name="ServicesSpotifyPlaylistBox" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyStartPlaylistButton" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyLoadPlaylistTracksButton" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyToggleFavoritePlaylistButton" x:FieldModifier="public"/>
                <ComboBox x:Name="ServicesSpotifyQuickPlaylistBox" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyStartQuickPlaylistButton" x:FieldModifier="public"/>
                <ListBox x:Name="ServicesSpotifyPlaylistTracksList" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyPlayPlaylistTrackButton" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyQueuePlaylistTrackButton" x:FieldModifier="public"/>
                <TextBlock x:Name="ServicesSpotifyPlaylistStatusText" x:FieldModifier="public"/>
                <CheckBox x:Name="ServicesSpotifyShufflePlaylistBox" x:FieldModifier="public"/>
                <Button x:Name="ServicesSpotifyResetStatisticsButton" x:FieldModifier="public"/>
                <TextBlock x:Name="ServicesSpotifyStatisticsEmptyText" x:FieldModifier="public"/>
                <ListBox x:Name="ServicesSpotifyTopTracksList" x:FieldModifier="public"/>
                <ListBox x:Name="ServicesSpotifyTopArtistsList" x:FieldModifier="public"/>
                <CheckBox x:Name="ServicesSpotifyOverlayEnabledBox" x:FieldModifier="public" IsChecked="True"/>
                <ComboBox x:Name="ServicesSpotifyOverlaySceneBox" x:FieldModifier="public"/>
                <ComboBox x:Name="ServicesSpotifyOverlaySourceBox" x:FieldModifier="public"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
