<UserControl x:Class="CreatorControlSuite.App.Views.Pages.Services.ObsServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22" MaxWidth="1120" HorizontalAlignment="Left" Style="{StaticResource CCSDarkSettingsContentStyle}">
                                <TextBlock Text="OBS-Steuerung" FontSize="22" FontWeight="Bold"/>
                                <TextBlock x:Name="ServicesObsStatusText" x:FieldModifier="public" Text="Nicht verbunden" Margin="0,10,0,12"/>
                                <WrapPanel>
                                    <Button x:Name="ServicesObsLaunchButton" x:FieldModifier="public" Content="OBS starten"/>
                                    <Button x:Name="ServicesObsConnectButton" x:FieldModifier="public" Content="Verbinden"/>
                                    <Button x:Name="ServicesObsDisconnectButton" x:FieldModifier="public" Content="Trennen"/>
                                    <Button x:Name="ServicesObsRefreshButton" x:FieldModifier="public" Content="Aktualisieren"/>
                                    <Button x:Name="ServicesObsStartStreamButton" x:FieldModifier="public" Content="Stream starten"/>
                                    <Button x:Name="ServicesObsStopStreamButton" x:FieldModifier="public" Content="Stream stoppen"/>
                                </WrapPanel>
                                <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="OBS LIVE CONTROL" FontSize="18" FontWeight="SemiBold"/>
                                        <UniformGrid Columns="4" Margin="0,10,0,0">
                                            <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="3">
                                                <StackPanel><TextBlock Text="STREAM" FontWeight="Bold"/><TextBlock x:Name="ServicesObsStreamStateText" x:FieldModifier="public" Text="Offline" Foreground="#9AA6AE" Margin="0,4,0,7"/><WrapPanel><Button x:Name="ServicesObsControlStartStreamButton" x:FieldModifier="public" Content="START"/><Button x:Name="ServicesObsControlStopStreamButton" x:FieldModifier="public" Content="STOP"/></WrapPanel></StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="3">
                                                <StackPanel><TextBlock Text="AUFNAHME" FontWeight="Bold"/><TextBlock x:Name="ServicesObsRecordStateText" x:FieldModifier="public" Text="Gestoppt" Foreground="#9AA6AE" Margin="0,4,0,7"/><WrapPanel><Button x:Name="ServicesObsStartRecordButton" x:FieldModifier="public" Content="START"/><Button x:Name="ServicesObsPauseRecordButton" x:FieldModifier="public" Content="PAUSE"/><Button x:Name="ServicesObsStopRecordButton" x:FieldModifier="public" Content="STOP"/></WrapPanel></StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="3">
                                                <StackPanel><TextBlock Text="REPLAY BUFFER" FontWeight="Bold"/><TextBlock x:Name="ServicesObsReplayStateText" x:FieldModifier="public" Text="Gestoppt" Foreground="#9AA6AE" Margin="0,4,0,7"/><WrapPanel><Button x:Name="ServicesObsStartReplayButton" x:FieldModifier="public" Content="START"/><Button x:Name="ServicesObsSaveReplayButton" x:FieldModifier="public" Content="SPEICHERN"/><Button x:Name="ServicesObsStopReplayButton" x:FieldModifier="public" Content="STOP"/></WrapPanel></StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="3">
                                                <StackPanel><TextBlock Text="VIRTUELLE KAMERA" FontWeight="Bold"/><TextBlock x:Name="ServicesObsVirtualCamStateText" x:FieldModifier="public" Text="Gestoppt" Foreground="#9AA6AE" Margin="0,4,0,7"/><WrapPanel><Button x:Name="ServicesObsStartVirtualCamButton" x:FieldModifier="public" Content="START"/><Button x:Name="ServicesObsStopVirtualCamButton" x:FieldModifier="public" Content="STOP"/></WrapPanel></StackPanel>
                                            </Border>
                                        </UniformGrid>
                                        <Grid Margin="3,10,3,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ServicesObsCpuText" x:FieldModifier="public" Text="CPU: –"/>
                                            <TextBlock Grid.Column="1" x:Name="ServicesObsFpsText" x:FieldModifier="public" Text="FPS: –"/>
                                            <TextBlock Grid.Column="2" x:Name="ServicesObsMemoryText" x:FieldModifier="public" Text="RAM: –"/>
                                            <TextBlock Grid.Column="3" x:Name="ServicesObsRenderLagText" x:FieldModifier="public" Text="Render-Lag: –"/>
                                            <TextBlock Grid.Column="4" x:Name="ServicesObsOutputLagText" x:FieldModifier="public" Text="Encoding-Lag: –"/>
                                        </Grid>
                                        <TextBlock x:Name="ServicesObsControlStatusText" x:FieldModifier="public" Text="Steuerung wird nach der Verbindung aktualisiert." Foreground="{DynamicResource TextMutedBrush}" Margin="3,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Zeitgesteuerte Quellen" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Wähle eine Szene und eine darin enthaltene Quelle. Lege fest, ob sie nach der angegebenen Zeit ein- oder ausgeblendet wird." Foreground="#9AA6AE" TextWrapping="Wrap" Margin="0,5,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0"><TextBlock Text="Szene"/><ComboBox x:Name="ServicesObsAutomationSceneBox" x:FieldModifier="public" DisplayMemberPath="Name" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"/></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Quelle"/><ComboBox x:Name="ServicesObsAutomationSourceBox" x:FieldModifier="public" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"/></StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Nach Sekunden"/><TextBox x:Name="ServicesObsAutomationDelayBox" x:FieldModifier="public" Text="10" Margin="0,5,0,0" HorizontalContentAlignment="Center"/></StackPanel>
                                            <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="Aktion"/><ComboBox x:Name="ServicesObsAutomationActionBox" x:FieldModifier="public" SelectedIndex="0" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"><ComboBoxItem Content="Einblenden" Tag="Show"/><ComboBoxItem Content="Ausblenden" Tag="Hide"/></ComboBox></StackPanel>
                                            <Button Grid.Column="4" x:Name="ServicesObsAutomationAddButton" x:FieldModifier="public" Content="HINZUFÜGEN" VerticalAlignment="Bottom"/>
                                        </Grid>
                                        <TextBlock x:Name="ServicesObsAutomationStatusText" x:FieldModifier="public" Foreground="#9AA6AE" Margin="0,8,0,0"/>
                                        <ListBox x:Name="ServicesObsAutomationRulesList" x:FieldModifier="public" Margin="0,12,0,0" MinHeight="150" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" DisplayMemberPath="Name"/>
                                        <WrapPanel Margin="0,8,0,0"><Button x:Name="ServicesObsAutomationDeleteButton" x:FieldModifier="public" Content="AUSGEWÄHLTE REGEL LÖSCHEN"/><Button x:Name="ServicesObsAutomationTestButton" x:FieldModifier="public" Content="JETZT TESTEN"/></WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="OBS-Übergang" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="ServicesObsTransitionBox" x:FieldModifier="public" DisplayMemberPath="Name" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,7,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Dauer (ms)" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            <TextBox x:Name="ServicesObsTransitionDurationBox" x:FieldModifier="public" Text="300" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,7,0,0" HorizontalContentAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" x:Name="ServicesObsApplyTransitionButton" x:FieldModifier="public" Content="ÜBERGANG ÜBERNEHMEN" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="ServicesObsTransitionStateText" x:FieldModifier="public" Text="Übergänge werden nach der OBS-Verbindung geladen." Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Szenen" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        <TextBox x:Name="ServicesObsSceneSearchBox" x:FieldModifier="public" Margin="0,8,0,0" ToolTip="Szenen durchsuchen"/>
                                        <TextBlock x:Name="ServicesObsCurrentSceneText" x:FieldModifier="public" Text="Aktuelle Szene: –" Foreground="#F39C12" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                        <ListBox x:Name="ServicesObsScenesList" x:FieldModifier="public" Height="225" DisplayMemberPath="Name" Margin="0,8,0,0" Background="{DynamicResource SidebarBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Button x:Name="ServicesObsSwitchSceneButton" x:FieldModifier="public" Content="Auf ausgewählte Szene wechseln" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Text="Quellen der ausgewählten Szene" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        <TextBox x:Name="ServicesObsSourceSearchBox" x:FieldModifier="public" Margin="0,8,0,0" ToolTip="Quellen durchsuchen"/>
                                        <ListBox x:Name="ServicesObsSceneItemsList" x:FieldModifier="public" Height="190" Margin="0,8,0,0" Background="{DynamicResource SidebarBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="3">
                                                        <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding SourceType}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                            <TextBlock Text=" · Ebene " Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                            <TextBlock Text="{Binding Index}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="ServicesObsSelectedSceneItemStateText" x:FieldModifier="public" Text="Quelle auswählen" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button x:Name="ServicesObsShowSceneItemButton" x:FieldModifier="public" Content="Einblenden" IsEnabled="False"/>
                                            <Button x:Name="ServicesObsHideSceneItemButton" x:FieldModifier="public" Content="Ausblenden" IsEnabled="False"/>
                                            <Button x:Name="ServicesObsLockSceneItemButton" x:FieldModifier="public" Content="Sperren" IsEnabled="False"/>
                                            <Button x:Name="ServicesObsUnlockSceneItemButton" x:FieldModifier="public" Content="Entsperren" IsEnabled="False"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button x:Name="ServicesObsMoveSceneItemUpButton" x:FieldModifier="public" Content="Eine Ebene nach oben" IsEnabled="False"/>
                                            <Button x:Name="ServicesObsMoveSceneItemDownButton" x:FieldModifier="public" Content="Eine Ebene nach unten" IsEnabled="False"/>
                                            <Button x:Name="ServicesObsRefreshSceneItemsButton" x:FieldModifier="public" Content="Quellen aktualisieren"/>
                                            <Button x:Name="ServicesObsRestartMediaButton" x:FieldModifier="public" Content="Medienquelle neu starten" IsEnabled="False"/>
                                            <Button x:Name="ServicesObsStopMediaButton" x:FieldModifier="public" Content="Medienquelle stoppen" IsEnabled="False"/>
                                            <Button x:Name="ServicesObsRefreshBrowserButton" x:FieldModifier="public" Content="Browserquelle neu laden" IsEnabled="False"/>
                                        </WrapPanel>
                                        <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Position und Größe" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,5,0"><TextBlock Text="X" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/><TextBox x:Name="ServicesObsSceneItemXBox" x:FieldModifier="public" Text="0" IsEnabled="False" HorizontalContentAlignment="Center"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="5,0"><TextBlock Text="Y" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/><TextBox x:Name="ServicesObsSceneItemYBox" x:FieldModifier="public" Text="0" IsEnabled="False" HorizontalContentAlignment="Center"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="5,0"><TextBlock Text="Breite" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/><TextBox x:Name="ServicesObsSceneItemWidthBox" x:FieldModifier="public" Text="1920" IsEnabled="False" HorizontalContentAlignment="Center"/></StackPanel>
                                                    <StackPanel Grid.Column="3" Margin="5,0,0,0"><TextBlock Text="Höhe" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/><TextBox x:Name="ServicesObsSceneItemHeightBox" x:FieldModifier="public" Text="1080" IsEnabled="False" HorizontalContentAlignment="Center"/></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,5,0"><TextBlock Text="Drehung °" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/><TextBox x:Name="ServicesObsSceneItemRotationBox" x:FieldModifier="public" Text="0" IsEnabled="False" HorizontalContentAlignment="Center"/></StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="5,0"><TextBlock Text="Zuschnitt L" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/><TextBox x:Name="ServicesObsSceneItemCropLeftBox" x:FieldModifier="public" Text="0" IsEnabled="False" HorizontalContentAlignment="Center"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="5,0"><TextBlock Text="Zuschnitt O" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/><TextBox x:Name="ServicesObsSceneItemCropTopBox" x:FieldModifier="public" Text="0" IsEnabled="False" HorizontalContentAlignment="Center"/></StackPanel>
                                                    <StackPanel Grid.Column="3" Margin="5,0"><TextBlock Text="Zuschnitt R" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/><TextBox x:Name="ServicesObsSceneItemCropRightBox" x:FieldModifier="public" Text="0" IsEnabled="False" HorizontalContentAlignment="Center"/></StackPanel>
                                                    <StackPanel Grid.Column="4" Margin="5,0,0,0"><TextBlock Text="Zuschnitt U" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/><TextBox x:Name="ServicesObsSceneItemCropBottomBox" x:FieldModifier="public" Text="0" IsEnabled="False" HorizontalContentAlignment="Center"/></StackPanel>
                                                </Grid>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button x:Name="ServicesObsApplySceneItemTransformButton" x:FieldModifier="public" Content="TRANSFORMATION ÜBERNEHMEN" IsEnabled="False"/>
                                                    <Button x:Name="ServicesObsReloadSceneItemTransformButton" x:FieldModifier="public" Content="WERTE AUS OBS LADEN" IsEnabled="False"/>
                                                    <Button x:Name="ServicesObsResetSceneItemTransformButton" x:FieldModifier="public" Content="ZURÜCKSETZEN" IsEnabled="False"/>
                                                </WrapPanel>
                                                <WrapPanel Margin="0,6,0,0">
                                                    <Button x:Name="ServicesObsSceneItemFullscreenButton" x:FieldModifier="public" Content="Vollbild 1920 × 1080" IsEnabled="False"/>
                                                    <Button x:Name="ServicesObsSceneItemCentered720Button" x:FieldModifier="public" Content="1280 × 720 zentriert" IsEnabled="False"/>
                                                </WrapPanel>
                                                <TextBlock Text="Position, Größe, Drehung und Zuschnitt werden direkt aus OBS geladen. Schnellvorlagen beziehen sich auf 1920 × 1080." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Quellenfilter" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                <ListBox x:Name="ServicesObsSourceFiltersList" x:FieldModifier="public" Height="130" Margin="0,8,0,0" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="3">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                                    <TextBlock Text=" · Ebene " Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Index}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock x:Name="ServicesObsSourceFilterStateText" x:FieldModifier="public" Text="Quelle auswählen, um Filter zu laden." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                <WrapPanel Margin="0,7,0,0">
                                                    <Button x:Name="ServicesObsEnableSourceFilterButton" x:FieldModifier="public" Content="FILTER AKTIVIEREN" IsEnabled="False"/>
                                                    <Button x:Name="ServicesObsDisableSourceFilterButton" x:FieldModifier="public" Content="FILTER DEAKTIVIEREN" IsEnabled="False"/>
                                                    <Button x:Name="ServicesObsRefreshSourceFiltersButton" x:FieldModifier="public" Content="FILTER AKTUALISIEREN" IsEnabled="False"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="Audiomixer" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        <TextBox x:Name="ServicesObsInputSearchBox" x:FieldModifier="public" Margin="0,8,0,0" ToolTip="Audioquellen durchsuchen"/>
                                        <ComboBox x:Name="ServicesObsInputFilterBox" x:FieldModifier="public" SelectedIndex="0" Margin="0,6,0,0">
                                            <ComboBoxItem Content="Alle Audioquellen" Tag="all"/>
                                            <ComboBoxItem Content="Nur Mikrofone" Tag="microphone"/>
                                            <ComboBoxItem Content="Nur Spiel/Desktop" Tag="game"/>
                                            <ComboBoxItem Content="Nur Musik" Tag="music"/>
                                            <ComboBoxItem Content="Nur Browser/Alerts" Tag="browser"/>
                                            <ComboBoxItem Content="Nur gemutete Quellen" Tag="muted"/>
                                        </ComboBox>
                                        <ListBox x:Name="ServicesObsInputsList" x:FieldModifier="public" Height="220" DisplayMemberPath="Name" Margin="0,8,0,0" Background="{DynamicResource SidebarBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="ServicesObsLiveMeterText" x:FieldModifier="public" Text="Live-Pegel: wartet auf OBS …" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                <ProgressBar x:Name="ServicesObsLiveMeterBar" x:FieldModifier="public" Minimum="-60" Maximum="10" Value="-60" Height="12" Margin="0,5,0,0"/>
                                                <TextBlock x:Name="ServicesObsPeakHoldText" x:FieldModifier="public" Text="Peak-Hold: -60.0 dB" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="ServicesObsSelectedInputStateText" x:FieldModifier="public" Text="Audioquelle auswählen" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="72"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="ServicesObsVolumeSlider" x:FieldModifier="public" Minimum="-60" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="False" IsEnabled="False" VerticalAlignment="Center" ToolTip="OBS-Lautstärke in dB"/>
                                            <TextBox Grid.Column="1" x:Name="ServicesObsVolumeDbBox" x:FieldModifier="public" Text="0.0" ToolTip="dB" IsEnabled="False" Margin="8,0,0,0" HorizontalContentAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="ServicesObsVolumePercentText" x:FieldModifier="public" Text="0 % · -60 dB = sehr leise · 0 dB = Standard · +10 dB = Verstärkung" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button x:Name="ServicesObsMuteInputButton" x:FieldModifier="public" Content="MUTE" IsEnabled="False"/>
                                            <Button x:Name="ServicesObsUnmuteInputButton" x:FieldModifier="public" Content="UNMUTE" IsEnabled="False"/>
                                            <Button x:Name="ServicesObsSetVolumeButton" x:FieldModifier="public" Content="PEGEL ÜBERNEHMEN" IsEnabled="False"/>
                                            <Button x:Name="ServicesObsRefreshInputStateButton" x:FieldModifier="public" Content="STATUS AKTUALISIEREN"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button x:Name="ServicesObsVolumeMinus20Button" x:FieldModifier="public" Content="-20 dB" IsEnabled="False"/>
                                            <Button x:Name="ServicesObsVolumeMinus10Button" x:FieldModifier="public" Content="-10 dB" IsEnabled="False"/>
                                            <Button x:Name="ServicesObsVolumeZeroButton" x:FieldModifier="public" Content="0 dB" IsEnabled="False"/>
                                        </WrapPanel>
                                        <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Schnellsteuerung und Gruppen" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                <WrapPanel Margin="0,7,0,0">
                                                    <Button x:Name="ServicesObsMuteAllButton" x:FieldModifier="public" Content="ALLE MUTEN"/>
                                                    <Button x:Name="ServicesObsUnmuteAllButton" x:FieldModifier="public" Content="ALLE ENTMUTEN"/>
                                                    <Button x:Name="ServicesObsOnlyMicButton" x:FieldModifier="public" Content="NUR MIKROFON"/>
                                                    <Button x:Name="ServicesObsOnlyGameButton" x:FieldModifier="public" Content="NUR SPIEL"/>
                                                </WrapPanel>
                                                <ComboBox x:Name="ServicesObsAudioGroupBox" x:FieldModifier="public" SelectedIndex="0" Margin="0,7,0,0">
                                                    <ComboBoxItem Content="Mikrofone" Tag="microphone"/>
                                                    <ComboBoxItem Content="Spiel/Desktop" Tag="game"/>
                                                    <ComboBoxItem Content="Musik" Tag="music"/>
                                                    <ComboBoxItem Content="Browser/Alerts" Tag="browser"/>
                                                </ComboBox>
                                                <WrapPanel Margin="0,7,0,0">
                                                    <TextBox x:Name="ServicesObsGroupVolumeBox" x:FieldModifier="public" Width="70" Text="-10" HorizontalContentAlignment="Center" ToolTip="Gruppenpegel in dB"/>
                                                    <Button x:Name="ServicesObsApplyGroupVolumeButton" x:FieldModifier="public" Content="GRUPPENPEGEL"/>
                                                    <Button x:Name="ServicesObsMuteGroupButton" x:FieldModifier="public" Content="GRUPPE MUTEN"/>
                                                    <Button x:Name="ServicesObsUnmuteGroupButton" x:FieldModifier="public" Content="GRUPPE ENTMUTEN"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Audio-Profile" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Speichert Pegel, Mute, Monitoring und Synchronisierung aller OBS-Audioquellen." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,7" TextWrapping="Wrap"/>
                                                <ComboBox x:Name="ServicesObsAudioProfileBox" x:FieldModifier="public" DisplayMemberPath="Name"/>
                                                <TextBox x:Name="ServicesObsAudioProfileNameBox" x:FieldModifier="public" Margin="0,7,0,0" ToolTip="Name für ein neues oder zu überschreibendes Profil"/>
                                                <WrapPanel Margin="0,7,0,0">
                                                    <Button x:Name="ServicesObsSaveAudioProfileButton" x:FieldModifier="public" Content="PROFIL SPEICHERN"/>
                                                    <Button x:Name="ServicesObsApplyAudioProfileButton" x:FieldModifier="public" Content="PROFIL LADEN"/>
                                                    <Button x:Name="ServicesObsDeleteAudioProfileButton" x:FieldModifier="public" Content="LÖSCHEN"/>
                                                </WrapPanel>
                                                <TextBlock x:Name="ServicesObsAudioProfileStateText" x:FieldModifier="public" Text="Noch kein Profil ausgewählt." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Erweiterte Audioeinstellungen" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Monitoring" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,8,0,3"/>
                                                <ComboBox x:Name="ServicesObsMonitoringBox" x:FieldModifier="public" IsEnabled="False">
                                                    <ComboBoxItem Content="Monitoring aus" Tag="OBS_MONITORING_TYPE_NONE"/>
                                                    <ComboBoxItem Content="Nur Monitor" Tag="OBS_MONITORING_TYPE_MONITOR_ONLY"/>
                                                    <ComboBoxItem Content="Monitor und Ausgabe" Tag="OBS_MONITORING_TYPE_MONITOR_AND_OUTPUT"/>
                                                </ComboBox>
                                                <TextBlock Text="Audio-Synchronisierung (ms)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,8,0,3"/>
                                                <TextBox x:Name="ServicesObsSyncOffsetBox" x:FieldModifier="public" Text="0" IsEnabled="False" HorizontalContentAlignment="Center"/>
                                                <Button x:Name="ServicesObsApplyAdvancedAudioButton" x:FieldModifier="public" Content="AUDIOEINSTELLUNGEN ÜBERNEHMEN" IsEnabled="False" Margin="0,8,0,0"/>
                                                <TextBlock Text="Positive Werte verzögern die Quelle. Geeignet, um Bild und Ton zu synchronisieren." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
</UserControl>
