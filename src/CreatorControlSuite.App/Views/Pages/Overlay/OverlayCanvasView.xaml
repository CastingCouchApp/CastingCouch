<UserControl x:Class="CreatorControlSuite.App.Views.Pages.Overlay.OverlayCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Canvas Overlay"
                   Foreground="{DynamicResource AccentBrush}"
                   Margin="0,6,0,6"
                   FontWeight="Bold"/>
        <TextBlock Text="Mehrere benannte Canvases für OBS (/view/…id…). Pro Design eine Browserquelle; Layout im Editor bearbeiten."
                   Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <TextBlock Text="Canvas"
                   Foreground="{DynamicResource MutedBrush}"
                   Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Margin="8,0,0,0">
                <Button Content="NEU"
                        Command="{Binding CreateCommand}"
                        Margin="0,0,6,0"
                        Padding="10,4"/>
                <Button Content="UMBENENNEN"
                        Command="{Binding RenameCommand}"
                        Margin="0,0,6,0"
                        Padding="10,4"/>
                <Button Content="DUPLIZIEREN"
                        Command="{Binding DuplicateCommand}"
                        Margin="0,0,6,0"
                        Padding="10,4"/>
                <Button Content="LÖSCHEN"
                        Command="{Binding DeleteCommand}"
                        Padding="10,4"/>
            </StackPanel>
            <ComboBox ItemsSource="{Binding Canvases}"
                      SelectedItem="{Binding SelectedCanvas}"
                      DisplayMemberPath="Name"
                      IsEditable="False"/>
        </DockPanel>
        <TextBlock Text="Canvas View (OBS)"
                   Foreground="{DynamicResource MutedBrush}"
                   Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,10">
            <Button Content="VIEW KOPIEREN"
                    Command="{Binding CopyViewUrlCommand}"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0"/>
            <TextBox Text="{Binding ViewUrl, Mode=OneWay}"
                     IsReadOnly="True"/>
        </DockPanel>
        <TextBlock Text="Editor"
                   Foreground="{DynamicResource MutedBrush}"
                   Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,10">
            <Button Content="EDITOR ÖFFNEN"
                    Command="{Binding OpenEditorCommand}"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource TextOnAccentBrush}"
                    FontWeight="Bold"/>
            <TextBox Text="{Binding EditorUrl, Mode=OneWay}"
                     IsReadOnly="True"/>
        </DockPanel>
        <TextBlock Text="Einzel-Widgets / Shapes (OBS)"
                   Foreground="{DynamicResource MutedBrush}"
                   Margin="0,0,0,4"/>
        <DockPanel>
            <Button Content="URL KOPIEREN"
                    Command="{Binding CopyWidgetUrlCommand}"
                    DockPanel.Dock="Right"
                    Margin="8,0,0,0"/>
            <ComboBox ItemsSource="{Binding WidgetUrls}"
                      SelectedItem="{Binding SelectedWidget}"
                      DisplayMemberPath="Label"
                      IsEditable="False"/>
        </DockPanel>
        <TextBlock Text="{Binding Status}"
                   Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0"/>
    </StackPanel>
</UserControl>
