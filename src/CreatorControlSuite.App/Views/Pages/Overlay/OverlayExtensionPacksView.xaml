<UserControl x:Class="CreatorControlSuite.App.Views.Pages.Overlay.OverlayExtensionPacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="9"
            Padding="14"
            Margin="0,16,0,0">
        <StackPanel>
            <TextBlock Text="Extension Packs"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="Bold"/>
            <TextBlock Text="ZIP-Pakete mit zusätzlichen Widgets, Effekten und Schriften. Installierte Packs werden unter /extensions und /ext/&lt;id&gt;/… ausgeliefert."
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,10"/>
            <ListBox ItemsSource="{Binding Packs}"
                     SelectedItem="{Binding SelectedPack}"
                     DisplayMemberPath="DisplayText"
                     Height="120"/>
            <StackPanel Orientation="Horizontal"
                        Margin="0,8,0,0">
                <Button Content="ZIP IMPORTIEREN"
                        Command="{Binding ImportCommand}"
                        Margin="0,0,6,0"
                        Padding="10,4"/>
                <Button Content="DEINSTALLIEREN"
                        Command="{Binding UninstallCommand}"
                        Padding="10,4"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
