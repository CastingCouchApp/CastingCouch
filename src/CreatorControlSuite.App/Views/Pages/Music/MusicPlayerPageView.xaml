<UserControl x:Class="CreatorControlSuite.App.Views.Pages.Music.MusicPlayerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CreatorControlSuite.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Music Player" FontSize="30" FontWeight="Bold" FontFamily="{DynamicResource AppHeadingFontFamily}"/>
            <TextBlock x:Name="MusicPlayerSubtitleText" Text="Aktiver Provider: Spotify" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0"/>
            <TextBlock Text="Player wechseln unter Einstellungen → Music Player." Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
            <controls:NowPlayingWidget x:Name="MusicNowPlayingWidget" Margin="0,10,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="148" Height="148" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Image x:Name="MusicPlayerCoverImage" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock x:Name="MusicPlayerTitleText" Text="Kein Titel" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="MusicPlayerArtistText" Text="-" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="MusicPlayerAlbumText" Text="Album: -" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="MusicPlayerStatusText" Text="Nicht verbunden" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="MusicPlayerPreviousButton" Content="Zurück" Margin="0,0,8,0"/>
                                <Button x:Name="MusicPlayerPlayPauseButton" Content="Play/Pause" Margin="0,0,8,0"/>
                                <Button x:Name="MusicPlayerNextButton" Content="Weiter" Margin="0,0,8,0"/>
                                <Button x:Name="MusicPlayerConnectButton" Content="Verbinden" Margin="0,0,8,0"/>
                                <Button x:Name="MusicPlayerDisconnectButton" Content="Trennen"/>
                            </StackPanel>
                            <Slider x:Name="MusicPlayerProgressBar" Minimum="0" Maximum="1" Value="0" Margin="0,16,0,4" IsMoveToPointEnabled="True"/>
                            <Grid>
                                <TextBlock x:Name="MusicPlayerProgressText" Text="00:00" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="MusicPlayerDurationText" Text="00:00" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <DockPanel Margin="0,14,0,0" x:Name="MusicPlayerVolumePanel">
                                <TextBlock Text="Lautstärke" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MusicPlayerVolumeText" Text="100 %" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <Slider x:Name="MusicPlayerVolumeSlider" Minimum="0" Maximum="100" Value="100" Margin="12,0,0,0"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="MusicPlayerYouTubePanel" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="YouTube Music Bookmarklet" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="1. Bridge verbinden&#10;2. Orangen Link in die Browser-Lesezeichenleiste ziehen (oder Install-Seite im Browser öffnen)&#10;3. Auf music.youtube.com das Lesezeichen einmal ausführen und den Tab offen lassen" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <Border x:Name="MusicPlayerBookmarkletDragChip" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="20" Padding="18,12" HorizontalAlignment="Left" Cursor="Hand" ToolTip="Ziehen und in die Lesezeichenleiste des Browsers ablegen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⋮⋮" Foreground="{DynamicResource TextOnAccentBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.8"/>
                                <TextBlock x:Name="MusicPlayerBookmarkletDragLabel" Text="CCS · YouTube Music" Foreground="{DynamicResource TextOnAccentBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Falls Ziehen aus der App nicht greift: Install-Seite im Browser öffnen und den Link dort ziehen." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="MusicPlayerOpenBookmarkletInstallButton" Content="Install-Seite öffnen" Margin="0,0,8,0"/>
                            <Button x:Name="MusicPlayerCopyBookmarkletButton" Content="Bookmarklet kopieren" Margin="0,0,8,0"/>
                            <TextBlock x:Name="MusicPlayerBridgeStatusText" Text="Bridge gestoppt" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <TextBox x:Name="MusicPlayerBookmarkletBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="56" AcceptsReturn="True" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <Border x:Name="MusicPlayerSpotifyHintPanel" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Spotify Extras" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Geräte, Playlists, Queue und Automation findest du unter Dienste → Spotify." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                        <Button x:Name="MusicPlayerOpenSpotifyServiceButton" Content="Spotify-Dienst öffnen" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
