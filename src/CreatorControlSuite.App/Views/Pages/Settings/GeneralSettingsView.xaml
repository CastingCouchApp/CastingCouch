<UserControl x:Class="CreatorControlSuite.App.Views.Pages.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" Style="{StaticResource CCSDarkSettingsContentStyle}">
            <TextBlock Text="Anzeigename"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="0,0,0,6"/>
            <TextBox Text="{Binding DisplayName}"/>
            <TextBlock Text="Kanalname"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="0,14,0,6"/>
            <TextBox Text="{Binding ChannelName}"/>
            <CheckBox IsChecked="{Binding StartWithWindows}"
                      Content="Mit Windows starten"
                      Margin="0,16,0,0"/>
            <CheckBox IsChecked="{Binding MinimizeToTray}"
                      Content="Beim Schließen in den Infobereich minimieren"
                      Margin="0,8,0,0"/>
            <Separator Margin="0,18,0,14"/>
            <TextBlock Text="Darstellung"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Theme"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="0,10,0,6"/>
            <ComboBox ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme}"
                      DisplayMemberPath="DisplayName"/>
            <TextBlock Text="{Binding ThemeDescription}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
            <CheckBox IsChecked="{Binding TitleBarWidgetCardsEnabled}"
                      Content="TitleBar-Widgets als Cards darstellen"
                      Margin="0,14,0,0"
                      ToolTip="Kartenrahmen um Stream/Qualität/Music/Community/Session/Countdown. Aus: flache Widgets mit Trennern."/>
            <Separator Margin="0,18,0,14"/>
            <TextBlock Text="Verbindungsüberwachung"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>
            <CheckBox IsChecked="{Binding ConnectionWatchdogEnabled}"
                      Content="Verbindungen automatisch überwachen und bei Abbruch wiederherstellen"
                      Margin="0,10,0,0"/>
            <TextBlock Text="Prüfintervall in Sekunden"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="0,12,0,6"/>
            <TextBox Text="{Binding ConnectionWatchdogSeconds}"
                     Width="100"
                     HorizontalAlignment="Left"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
            <WrapPanel Margin="0,12,0,0">
                <CheckBox IsChecked="{Binding ReconnectObs}"
                          Content="OBS"
                          Margin="0,0,16,0"/>
                <CheckBox IsChecked="{Binding ReconnectTwitch}"
                          Content="Twitch"
                          Margin="0,0,16,0"/>
                <CheckBox IsChecked="{Binding ReconnectSpotify}"
                          Content="Spotify"
                          Margin="0,0,16,0"/>
                <CheckBox IsChecked="{Binding ReconnectYouTubeMusic}"
                          Content="YouTube Music"
                          Margin="0,0,16,0"/>
                <CheckBox IsChecked="{Binding ReconnectStreamerBot}"
                          Content="Streamer.bot"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
