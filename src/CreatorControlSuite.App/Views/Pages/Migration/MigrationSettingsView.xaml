<UserControl x:Class="CreatorControlSuite.App.Views.Pages.Migration.MigrationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource InputAltBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Margin="0,18,0,0">
        <StackPanel>
            <TextBlock Text="Migration aus der bisherigen Suite"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="Bold"/>
            <TextBlock Text="Die Suche erkennt alte Einstellungsordner, Overlay-Inhalte und Alert-Dateien."
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
            <WrapPanel Margin="0,12,0,0">
                <Button Content="Alte Suite suchen"
                        Command="{Binding DetectCommand}"/>
                <Button Content="Ausgewählten Fund importieren"
                        Command="{Binding ImportCommand}"
                        Background="#416B3C"/>
            </WrapPanel>
            <ListBox ItemsSource="{Binding Candidates}"
                     SelectedItem="{Binding SelectedCandidate}"
                     Height="130"
                     Background="{DynamicResource WindowBackgroundBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     DisplayMemberPath="SourcePath"
                     Margin="0,10,0,0"/>
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground"
                                Value="{DynamicResource MutedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsSuccess}"
                                         Value="True">
                                <Setter Property="Foreground"
                                        Value="LightGreen"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusIsError}"
                                         Value="True">
                                <Setter Property="Foreground"
                                        Value="IndianRed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
