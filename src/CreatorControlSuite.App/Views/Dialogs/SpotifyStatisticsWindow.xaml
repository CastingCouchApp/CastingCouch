<Window x:Class="CreatorControlSuite.App.Views.Dialogs.SpotifyStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotify · Statistik"
        Width="900" Height="620" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Spotify-Statistik" FontSize="26" FontWeight="Bold"/>
            <TextBlock x:Name="SummaryText" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,14"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <GroupBox Header="Songs" Margin="0,0,7,0">
                <ListBox x:Name="TracksList" DisplayMemberPath="DisplayText"
                         Background="{DynamicResource ElevatedBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Interpreten" Margin="7,0,0,0">
                <ListBox x:Name="ArtistsList" DisplayMemberPath="DisplayText"
                         Background="{DynamicResource ElevatedBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
            </GroupBox>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Die Statistik wird ausschließlich lokal gespeichert."
                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
            <WrapPanel DockPanel.Dock="Right">
                <Button x:Name="ResetButton" Content="ZURÜCKSETZEN" Background="#7A3838" Margin="0,0,8,0"/>
                <Button x:Name="CloseButton" Content="SCHLIESSEN"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
