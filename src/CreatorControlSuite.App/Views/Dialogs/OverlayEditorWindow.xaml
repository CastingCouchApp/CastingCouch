<Window x:Class="CreatorControlSuite.App.Views.Dialogs.OverlayEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Overlay Editor"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="Fenster" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource MutedBrush}"/>
                <ComboBox x:Name="WindowSizeCombo" Width="200" VerticalAlignment="Center"/>
                <Button x:Name="OpenInBrowserButton" Content="IM BROWSER" Margin="8,0,0,0" Padding="12,6"/>
                <Button x:Name="ReloadButton" Content="NEULADEN" Margin="8,0,0,0" Padding="12,6"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Overlay Editor" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="UrlText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True"
                Background="#0c0a09">
            <wv2:WebView2 x:Name="EditorWebView" DefaultBackgroundColor="Transparent"/>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="CloseButton" Content="SCHLIESSEN" DockPanel.Dock="Right"
                    Padding="18,7"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource TextOnAccentBrush}"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
