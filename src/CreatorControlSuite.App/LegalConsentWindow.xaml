<Window x:Class="CreatorControlSuite.App.LegalConsentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Creator Control Suite – Rechtliche Hinweise" Width="900" Height="700" WindowStartupLocation="CenterScreen" Background="#101010" Foreground="White">
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Rechtliche Hinweise" FontSize="30" FontWeight="Bold"/><TextBlock Text="Vor der Nutzung müssen die aktuellen Dokumente bestätigt werden." Foreground="#FF8C00" Margin="0,6,0,0"/></StackPanel>
<TabControl Grid.Row="1" Margin="0,18,0,18" Background="#181818" BorderBrush="#333"><TabItem Header="EULA"><TextBox x:Name="EulaTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#151515" Foreground="White"/></TabItem><TabItem Header="Datenschutz"><TextBox x:Name="PrivacyTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#151515" Foreground="White"/></TabItem></TabControl>
<Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><CheckBox x:Name="AcceptEulaBox" Content="Ich akzeptiere die Endbenutzer-Lizenzvereinbarung."/><CheckBox x:Name="AcknowledgePrivacyBox" Content="Ich habe die Datenschutzhinweise zur Kenntnis genommen." Margin="0,8,0,0"/></StackPanel><WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,14,0,0"><Button x:Name="CancelButton" Content="Beenden" Padding="14,9" Margin="4"/><Button x:Name="AcceptButton" Content="Bestätigen und fortfahren" Background="#FF8C00" Foreground="White" FontWeight="Bold" Padding="14,9" Margin="4"/></WrapPanel></Grid>
</Grid></Window>
