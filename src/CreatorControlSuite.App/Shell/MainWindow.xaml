            </Grid>
            <Grid x:Name="ProfilesPage" Visibility="Collapsed">
                <profiles:ProfilesPageView x:Name="ProfilesPageViewHost"/>
            </Grid>
            <Grid x:Name="MultiPcPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Multi-PC (Alpha)" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Geräte im lokalen Streaming-Netz verwalten, koppeln und überwachen." Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,14">
                    <Border Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="LOKALER AGENT" Foreground="#87939C"/><TextBlock x:Name="MultiPcLocalAgentStatusText" Text="Wird geprüft…" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="GERÄTE" Foreground="#87939C"/><TextBlock x:Name="MultiPcDeviceCountText" Text="0" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="ONLINE" Foreground="#87939C"/><TextBlock x:Name="MultiPcOnlineCountText" Text="0" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="PAIRING-CODE" Foreground="#87939C"/><TextBlock x:Name="MultiPcPairingCodeText" Text="------" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
                </UniformGrid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,12,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel><TextBlock Text="GERÄTEÜBERSICHT" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="MultiPcDiscoverButton" Content="LAN SUCHEN" Padding="12,6" Margin="0,0,8,0"/><Button x:Name="MultiPcRefreshButton" Content="AKTUALISIEREN" Padding="12,6"/></StackPanel></DockPanel>
                            <ListBox x:Name="MultiPcDevicesList" Grid.Row="1" Margin="0,12,0,0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="GERÄT KOPPELN" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="Gerätename" Foreground="{DynamicResource TextMutedBrush}" Margin="0,14,0,5"/><TextBox x:Name="MultiPcDeviceNameBox" Text="Streaming-PC"/>
                            <TextBlock Text="IP-Adresse oder Hostname" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,5"/><TextBox x:Name="MultiPcHostBox" Text="192.168.0.20"/>
                            <TextBlock Text="Pairing-Code des Agenten" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,5"/><TextBox x:Name="MultiPcPairingInputBox"/><TextBlock Text="SHA-256-Fingerprint des Agenten" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,5"/><TextBox x:Name="MultiPcCertificateFingerprintBox" ToolTip="Direkt aus der Agent-Anzeige übernehmen und über einen vertrauenswürdigen Kanal vergleichen."/><TextBlock Text="MAC-Adresse (für Wake-on-LAN)" Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,5"/><TextBox x:Name="MultiPcMacAddressBox"/>
                            <Button x:Name="MultiPcAddDeviceButton" Content="GERÄT HINZUFÜGEN" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextOnAccentBrush}" FontWeight="Bold" Margin="0,16,0,0"/>
                            <Button x:Name="MultiPcRemoveDeviceButton" Content="AUSGEWÄHLTES GERÄT ENTFERNEN" Margin="0,8,0,0"/>
                            <Button x:Name="MultiPcGeneratePairingCodeButton" Content="PAIRING-EINGABEN LEEREN" Margin="0,8,0,0"/>
                            <Separator Margin="0,14,0,10"/>
                            <TextBlock Text="REMOTE-STEUERUNG" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="Agent-Port" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,5"/><TextBox x:Name="MultiPcAgentPortBox" Text="47631"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="MultiPcObsStartButton" Content="OBS STARTEN" Margin="0,0,6,6"/>
                                <Button x:Name="MultiPcObsStopButton" Content="OBS BEENDEN" Margin="0,0,6,6"/>
                                <Button x:Name="MultiPcSpotifyPlayPauseButton" Content="SPOTIFY PLAY/PAUSE" Margin="0,0,6,6"/>
                                <Button x:Name="MultiPcStreamerBotStartButton" Content="STREAMER.BOT STARTEN" Margin="0,0,6,6"/>
                                <Button x:Name="MultiPcSystemRestartButton" Content="PC NEUSTARTEN" Margin="0,0,6,6" Background="#6B4A1F"/>
                                <Button x:Name="MultiPcSystemShutdownButton" Content="PC HERUNTERFAHREN" Margin="0,0,6,6" Background="#7A3838"/>
                            </WrapPanel>
                            <Button x:Name="MultiPcWakeButton" Content="PC PER WAKE-ON-LAN STARTEN" Margin="0,4,0,0" Background="#315A3A"/><Button x:Name="MultiPcAgentDiagnosticsButton" Content="AGENT-DIAGNOSE ABRUFEN" Margin="0,6,0,0"/>
                            <TextBlock Text="REMOTE-OBS" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,5"/>
                            <Button x:Name="MultiPcObsRefreshStateButton" Content="SZENEN UND AUDIO LADEN"/>
                            <ComboBox x:Name="MultiPcObsScenesBox" Margin="0,6,0,0"/>
                            <Button x:Name="MultiPcObsSwitchSceneButton" Content="AUSGEWÄHLTE SZENE AKTIVIEREN" Margin="0,6,0,0"/>
                            <ComboBox x:Name="MultiPcObsAudioInputsBox" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,6,0,0"><Button x:Name="MultiPcObsMuteButton" Content="MUTEN" Margin="0,0,6,0"/><Button x:Name="MultiPcObsUnmuteButton" Content="ENTMUTEN"/></WrapPanel>
                            <WrapPanel Margin="0,6,0,0"><TextBox x:Name="MultiPcObsVolumeBox" Text="-10" Width="90" Margin="0,0,6,0"/><Button x:Name="MultiPcObsSetVolumeButton" Content="LAUTSTÄRKE SETZEN" Margin="0,0,6,0"/><TextBox x:Name="MultiPcObsFadeDurationBox" Text="1000" Width="80" Margin="0,0,6,0"/><Button x:Name="MultiPcObsFadeVolumeButton" Content="LAUTSTÄRKE FADEN"/></WrapPanel>
                            <TextBlock Text="SZENEN-QUELLEN" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,5"/>
                            <ComboBox x:Name="MultiPcObsSceneItemsBox"/>
                            <WrapPanel Margin="0,6,0,0"><Button x:Name="MultiPcObsSourceShowButton" Content="EINBLENDEN" Margin="0,0,6,0"/><Button x:Name="MultiPcObsSourceHideButton" Content="AUSBLENDEN" Margin="0,0,6,0"/><Button x:Name="MultiPcObsResetTransformButton" Content="TRANSFORM ZURÜCKSETZEN"/></WrapPanel>
                            <WrapPanel Margin="0,6,0,0"><TextBox x:Name="MultiPcObsPosXBox" Text="0" Width="70" Margin="0,0,5,0"/><TextBox x:Name="MultiPcObsPosYBox" Text="0" Width="70" Margin="0,0,5,0"/><TextBox x:Name="MultiPcObsWidthBox" Text="640" Width="70" Margin="0,0,5,0"/><TextBox x:Name="MultiPcObsHeightBox" Text="360" Width="70" Margin="0,0,5,0"/><TextBox x:Name="MultiPcObsRotationBox" Text="0" Width="60" Margin="0,0,5,0"/><Button x:Name="MultiPcObsApplyTransformButton" Content="TRANSFORM SETZEN"/></WrapPanel>
                            <TextBlock Text="QUELLENFILTER" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,4"/><ComboBox x:Name="MultiPcObsFiltersBox"/><WrapPanel Margin="0,6,0,0"><Button x:Name="MultiPcObsFilterEnableButton" Content="FILTER AKTIVIEREN" Margin="0,0,6,0"/><Button x:Name="MultiPcObsFilterDisableButton" Content="FILTER DEAKTIVIEREN"/></WrapPanel>
                            <CheckBox x:Name="MultiPcObsAutoSyncCheckBox" Content="OBS-Status automatisch alle 5 Sekunden synchronisieren" Margin="0,8,0,0"/>
                            <TextBlock Text="OBS-PROFILE UND SZENENSAMMLUNG" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,5"/>
                            <Button x:Name="MultiPcObsLoadConfigurationButton" Content="PROFILE UND SAMMLUNGEN LADEN"/>
                            <ComboBox x:Name="MultiPcObsProfilesBox" Margin="0,6,0,0"/>
                            <Button x:Name="MultiPcObsApplyProfileButton" Content="PROFIL AKTIVIEREN" Margin="0,6,0,0"/>
                            <ComboBox x:Name="MultiPcObsSceneCollectionsBox" Margin="0,6,0,0"/>
                            <Button x:Name="MultiPcObsApplySceneCollectionButton" Content="SZENENSAMMLUNG AKTIVIEREN" Margin="0,6,0,0"/>
                            <TextBlock Text="REMOTE-OBS-PRESETS" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,5"/>
                            <TextBox x:Name="MultiPcObsPresetNameBox" Text="Streaming-Standard"/>
                            <WrapPanel Margin="0,6,0,0"><Button x:Name="MultiPcObsSavePresetButton" Content="AKTUELLEN ZUSTAND SPEICHERN" Margin="0,0,6,6"/><Button x:Name="MultiPcObsLoadPresetsButton" Content="PRESETS LADEN" Margin="0,0,6,6"/></WrapPanel>
                            <ComboBox x:Name="MultiPcObsPresetsBox" Margin="0,2,0,0"/>
                            <WrapPanel Margin="0,6,0,0"><Button x:Name="MultiPcObsApplyPresetButton" Content="PRESET WIEDERHERSTELLEN" Margin="0,0,6,6" Background="#315A3A"/><Button x:Name="MultiPcObsDeletePresetButton" Content="PRESET LÖSCHEN" Margin="0,0,6,6" Background="#7A3838"/></WrapPanel>
                            <TextBlock Text="OBS-AUSGABE" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,5"/>
                            <TextBlock x:Name="MultiPcObsOutputStatusText" Text="Stream: unbekannt · Aufnahme: unbekannt" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,6,0,0"><Button x:Name="MultiPcObsStreamStartButton" Content="STREAM START" Margin="0,0,6,6"/><Button x:Name="MultiPcObsStreamStopButton" Content="STREAM STOP" Margin="0,0,6,6"/><Button x:Name="MultiPcObsRecordStartButton" Content="AUFNAHME START" Margin="0,0,6,6"/><Button x:Name="MultiPcObsRecordStopButton" Content="AUFNAHME STOP" Margin="0,0,6,6"/><Button x:Name="MultiPcObsRecordPauseButton" Content="PAUSE/FORTSETZEN" Margin="0,0,6,6"/></WrapPanel>
                            <ComboBox x:Name="MultiPcObsTransitionsBox" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,6,0,0"><TextBox x:Name="MultiPcObsTransitionDurationBox" Text="300" Width="90" Margin="0,0,6,0"/><Button x:Name="MultiPcObsApplyTransitionButton" Content="ÜBERGANG SETZEN"/></WrapPanel>
                            <Button x:Name="MultiPcObsPreviewRefreshButton" Content="PROGRAMMVORSCHAU LADEN" Margin="0,8,0,0"/>
                            <Border Height="180" Margin="0,6,0,0" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"><Image x:Name="MultiPcObsPreviewImage" Stretch="Uniform"/></Border>
                            <TextBlock Text="OBS WebSocket auf Ziel-PC" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,5"/><TextBox x:Name="MultiPcRemoteObsHostBox" Text="127.0.0.1"/>
                            <TextBox x:Name="MultiPcRemoteObsPortBox" Text="4455" Margin="0,5,0,0"/><PasswordBox x:Name="MultiPcRemoteObsPasswordBox" Margin="0,5,0,0"/>
                            <Button x:Name="MultiPcSaveAgentSettingsButton" Content="AGENT-EINSTELLUNGEN SPEICHERN" Margin="0,6,0,0"/>
                            <TextBlock Text="REMOTE-DATEIEN UND DIAGNOSE" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,5"/>
                            <WrapPanel><Button x:Name="MultiPcLoadAgentLogsButton" Content="AGENT-LOGS LADEN" Margin="0,0,6,6"/><Button x:Name="MultiPcStageUpdateButton" Content="UPDATE-ZIP BEREITSTELLEN" Margin="0,0,6,6" Background="#6B4A1F"/></WrapPanel>
                            <TextBlock Text="REMOTE-UPDATE" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,5"/>
                            <TextBlock x:Name="MultiPcUpdateStatusText" Text="Kein Update-Status geladen." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            <CheckBox x:Name="MultiPcRestartSuiteAfterUpdateCheckBox" Content="Suite nach Update neu starten" IsChecked="True" Margin="0,6,0,0"/>
                            <CheckBox x:Name="MultiPcAutomaticRollbackCheckBox" Content="Bei fehlgeschlagenem Health-Check automatisch zurückrollen" IsChecked="True" Margin="0,4,0,0"/>
                            <WrapPanel Margin="0,6,0,0"><Button x:Name="MultiPcLoadUpdateStatusButton" Content="UPDATE-STATUS LADEN" Margin="0,0,6,6"/><Button x:Name="MultiPcLoadUpdateHistoryButton" Content="UPDATE-HISTORIE" Margin="0,0,6,6"/><Button x:Name="MultiPcValidateUpdateButton" Content="PAKET PRÜFEN" Margin="0,0,6,6" Background="#38536A"/><Button x:Name="MultiPcApplyUpdateButton" Content="UPDATE ANWENDEN" Margin="0,0,6,6" Background="#315A3A"/><Button x:Name="MultiPcRollbackUpdateButton" Content="ROLLBACK" Margin="0,0,6,6" Background="#7A3838"/></WrapPanel>
                            <ListBox x:Name="MultiPcUpdateHistoryList" Height="105" Margin="0,4,0,0" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="GESTAFFELTER ROLLOUT" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,5"/>
                            <TextBlock Text="Verteilt Updates kontrolliert an eine Gerätegruppe. Canary-Geräte werden zuerst aktualisiert; bei Fehlern oder überschrittener Fehlerquote stoppt der Rollout automatisch." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,6,0,0"><TextBlock Text="Ausgewählten PC zu Gruppe" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="MultiPcDeviceRolloutGroupBox" Width="120" Margin="0,0,6,0"/><Button x:Name="MultiPcAssignRolloutGroupButton" Content="GRUPPE ZUWEISEN" Margin="0,0,6,6"/></WrapPanel>
                            <WrapPanel Margin="0,4,0,0"><TextBlock Text="Zielgruppe" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="MultiPcRolloutTargetGroupBox" Width="120" IsEditable="True" Text="Alle" Margin="0,0,10,0"/><TextBlock Text="Canary-Anzahl" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="MultiPcCanaryCountBox" Text="1" Width="45" Margin="0,0,10,0"/><TextBlock Text="Max. Fehlerquote %" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="MultiPcMaxFailurePercentBox" Text="25" Width="45"/></WrapPanel>
                            <CheckBox x:Name="MultiPcStopOnFailureThresholdCheckBox" Content="Rollout bei überschrittener Fehlerquote automatisch stoppen" IsChecked="True" Margin="0,5,0,0"/>
                            <WrapPanel Margin="0,6,0,0"><TextBlock Text="Pause zwischen Geräten (Sekunden)" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="MultiPcRolloutDelayBox" Text="20" Width="55" Margin="0,0,6,0"/><Button x:Name="MultiPcStartRolloutButton" Content="GRUPPEN-ROLLOUT STARTEN" Margin="0,0,6,6" Background="#315A3A"/><Button x:Name="MultiPcCancelRolloutButton" Content="ROLLOUT ABBRECHEN" Margin="0,0,6,6" Background="#7A3838"/></WrapPanel>
                            <WrapPanel Margin="0,4,0,0"><CheckBox x:Name="MultiPcUseMaintenanceWindowCheckBox" Content="Wartungsfenster verwenden" Margin="0,0,10,0"/><TextBlock Text="von" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="MultiPcMaintenanceStartBox" Text="02:00" Width="55" Margin="0,0,8,0"/><TextBlock Text="bis" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="MultiPcMaintenanceEndBox" Text="05:00" Width="55"/></WrapPanel>
                            <WrapPanel Margin="0,4,0,0"><TextBlock Text="Rollout planen für" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="MultiPcRolloutScheduleBox" Text="morgen 02:00" Width="130" Margin="0,0,6,0"/><Button x:Name="MultiPcScheduleRolloutButton" Content="ROLLOUT PLANEN" Margin="0,0,6,6" Background="#384F7A"/><Button x:Name="MultiPcCancelScheduledRolloutButton" Content="PLANUNG AUFHEBEN" Margin="0,0,6,6"/><CheckBox x:Name="MultiPcResumePausedRolloutCheckBox" Content="nach Neustart fortsetzen" IsChecked="True" Margin="0,0,0,6"/></WrapPanel>
                            <TextBlock x:Name="MultiPcScheduledRolloutStatusText" Text="Kein Rollout geplant." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                            <WrapPanel Margin="0,2,0,4"><Button x:Name="MultiPcLoadAuditButton" Content="AUDITPROTOKOLL LADEN" Margin="0,0,6,6"/><TextBlock Text="Dauerhaftes JSONL-Protokoll aller Remote-Update-Aktionen" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/></WrapPanel>
                            <ListBox x:Name="MultiPcRolloutStatusList" Height="125" Margin="0,4,0,0" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox x:Name="MultiPcAgentLogsBox" Height="150" Margin="0,4,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource WindowBackgroundBrush}" Foreground="#D9E1E6"/>
                            <TextBlock Text="LETZTE REMOTE-AKTIONEN" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,5"/><ListBox x:Name="MultiPcHistoryList" Height="120" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="MultiPcTrustText" Text="TLS-Vertrauen: kein Gerät ausgewählt" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock x:Name="MultiPcSelectedDeviceText" Text="Kein Remote-Gerät ausgewählt." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <TextBlock x:Name="MultiPcStatusText" Text="Bereit." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="AboutPage" Visibility="Collapsed">
                <about:AboutPageView x:Name="AboutPageViewHost"/>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>
