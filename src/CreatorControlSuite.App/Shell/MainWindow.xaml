<?xml version='1.0' encoding='UTF-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:CreatorControlSuite.App.Controls"
        xmlns:diag="clr-namespace:CreatorControlSuite.App.Views.Pages.Diagnostics"
        xmlns:profiles="clr-namespace:CreatorControlSuite.App.Views.Pages.Profiles"
        xmlns:about="clr-namespace:CreatorControlSuite.App.Views.Pages.About"
        xmlns:updates="clr-namespace:CreatorControlSuite.App.Views.Pages.Updates"
        xmlns:migration="clr-namespace:CreatorControlSuite.App.Views.Pages.Migration"
        xmlns:legal="clr-namespace:CreatorControlSuite.App.Views.Pages.Legal"
        xmlns:settings="clr-namespace:CreatorControlSuite.App.Views.Pages.Settings"
        xmlns:twitchgoals="clr-namespace:CreatorControlSuite.App.Views.Pages.Twitch"
        xmlns:spotify="clr-namespace:CreatorControlSuite.App.Views.Pages.Spotify"
        xmlns:workflow="clr-namespace:CreatorControlSuite.App.Views.Pages.Workflow"
        xmlns:overlayconfig="clr-namespace:CreatorControlSuite.App.Views.Pages.Overlay"
        xmlns:alertsview="clr-namespace:CreatorControlSuite.App.Views.Pages.Alerts"
        xmlns:statistics="clr-namespace:CreatorControlSuite.App.Views.Pages.Statistics"
        xmlns:music="clr-namespace:CreatorControlSuite.App.Views.Pages.Music"
        xmlns:services="clr-namespace:CreatorControlSuite.App.Views.Pages.Services"
        xmlns:dashboard="clr-namespace:CreatorControlSuite.App.Views.Pages.Dashboard"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        x:Class="CreatorControlSuite.App.Shell.MainWindow"
        Title="CastingCouch"
        Icon="pack://application:,,,/Assets/Brand/app.ico"
        Width="1600"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="140"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource ScrollBarBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ScrollBarForegroundBrush}"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Border Height="1"
                        VerticalAlignment="Top"
                        Background="{DynamicResource TitleBarHighlightBrush}"
                        IsHitTestVisible="False"
                        Panel.ZIndex="1"/>
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="TitleBarBrandPanel"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,0"
                            IsHitTestVisible="False">
                    <Border Width="36" Height="36" CornerRadius="8" ClipToBounds="True" Margin="0,0,6,0">
                        <Image Source="Assets/Brand/app.png"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CastingCouch"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="20"
                                   FontWeight="Light"
                                   FontFamily="{DynamicResource AppHeadingFontFamily}"/>
                    </StackPanel>
                </StackPanel>
                <Grid x:Name="DashboardTopStatusRow"
                      Grid.Column="1"
                      Margin="0,6,0,6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True"
                      MouseRightButtonUp="TitleBar_MouseRightButtonUp">
                    <Border x:Name="DashboardServiceStatusSection" Background="Transparent" BorderThickness="0" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Stream-Widget: Live-Status -->
                            <Border x:Name="DashboardTitleBarStreamWidget"
                                    Style="{StaticResource TitleBarWidgetStyle}"
                                    Tag="TitleBarChromeWidget"
                                    Uid="Stream"
                                    MinWidth="172"
                                    Padding="10,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="38" Height="38" CornerRadius="8" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" Margin="0,0,9,0">
                                            <TextBlock Text="●" Foreground="{DynamicResource SuccessBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Stream" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Ellipse x:Name="StreamDashboardLamp" Width="7" Height="7" Fill="IndianRed" Margin="0,5,6,0"/>
                                        <TextBlock x:Name="StreamDashboardStatus" Text="OFFLINE" Foreground="{DynamicResource SuccessBrush}" FontSize="12" TextWrapping="NoWrap"/>
                                        <TextBlock Text="  "/>
                                        <TextBlock x:Name="DashboardStreamDetailText" Text="00:00:00" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                    <Button x:Name="DashboardHeaderStreamActionButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Stream abhängig vom aktuellen Zustand starten oder beenden" Content="●  LIVE GEHEN" Background="{DynamicResource DangerBrush}" Foreground="{DynamicResource TextOnAccentBrush}" BorderBrush="{DynamicResource DangerBrush}" FontWeight="Bold" Height="28" Padding="10,2" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1"
                                    Style="{StaticResource TitleBarDividerStyle}"
                                    Tag="TitleBarChromeDivider"
                                    Uid="Quality"/>
                            <!-- Qualitäts-Widget neben Stream -->
                            <Border Grid.Column="2"
                                    Style="{StaticResource TitleBarWidgetStyle}"
                                    Tag="TitleBarChromeWidget"
                                    Uid="Quality"
                                    MinWidth="220"
                                    x:Name="DashboardStreamQualityModule">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Ellipse x:Name="DashboardStreamQualityLamp" Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}" Margin="0,4,7,0" DockPanel.Dock="Left"/>
                                        <TextBlock Text="Qualität" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock x:Name="DashboardStreamQualityStatusText" Text="OBS nicht verbunden" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <UniformGrid Columns="2" Margin="0,10,0,0">
                                        <StackPanel Margin="0,0,10,6">
                                            <TextBlock Text="BITRATE" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                            <TextBlock x:Name="DashboardStreamBitrateText" Text="0 kbps" FontSize="14" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="FPS" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                            <TextBlock x:Name="DashboardStreamFpsText" Text="0 / 60" FontSize="14" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="DROPS" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                            <TextBlock x:Name="DashboardDroppedFramesText" Text="0 (0 %)" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="RENDER" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                            <TextBlock x:Name="DashboardRenderLagText" Text="0 (0 %)" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock x:Name="DashboardStreamQualityDetailText" Text="Stream ist offline" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3"
                                    Style="{StaticResource TitleBarDividerStyle}"
                                    Tag="TitleBarChromeDivider"
                                    Uid="Music"/>
                            <!-- Music Player in der Dashboard-Titelleiste -->
                            <Border x:Name="DashboardTopMusicWidget"
                                    Grid.Column="4"
                                    Style="{StaticResource TitleBarWidgetStyle}"
                                    Tag="TitleBarChromeWidget"
                                    Uid="Music"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Width="350"
                                    MaxWidth="350"
                                    Cursor="Hand"
                                    ToolTip="Music Player öffnen">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="84" Height="84" CornerRadius="6" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                                        <Image x:Name="DashboardTopMusicCoverImage" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="DashboardTopMusicProviderText" Text="MUSIC PLAYER" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold"/>
                                        <Border x:Name="DashboardTopMusicTitleViewport"
                                                ClipToBounds="True"
                                                Margin="0,4,0,0"
                                                Height="24">
                                            <TextBlock x:Name="DashboardTopMusicTitleText"
                                                       Text="Kein Titel"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap"
                                                       HorizontalAlignment="Left">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="DashboardTopMusicTitleTranslate"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock x:Name="DashboardTopMusicArtistText" Text="-" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="DashboardTopMusicAlbumText" Text="Album: -" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="DashboardTopMusicStatusText" Text="Nicht verbunden" Foreground="{DynamicResource AccentBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Slider x:Name="DashboardTopMusicVolumeSlider" shell:WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="1" Minimum="0" Maximum="100" Value="100" Height="16" Margin="6,0,4,0" VerticalAlignment="Center" ToolTip="Spotify-Lautstärke"/>
                                            <TextBlock x:Name="DashboardTopMusicVolumeText" Grid.Column="2" Text="100 %" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="DashboardTopMusicPreviousButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Content="⏮" Width="28" Height="28" FontSize="12" Padding="0" Margin="0,0,4,0" MinWidth="28" MinHeight="28" ToolTip="Zurück"/>
                                        <Button x:Name="DashboardTopMusicPlayPauseButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Content="▶" Width="32" Height="28" FontSize="12" FontWeight="Bold" Padding="0" Margin="0,0,4,0" MinWidth="32" MinHeight="28" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextOnAccentBrush}" ToolTip="Play/Pause"/>
                                        <Button x:Name="DashboardTopMusicNextButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Content="⏭" Width="28" Height="28" FontSize="12" Padding="0" Margin="0" MinWidth="28" MinHeight="28" ToolTip="Weiter"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="5"
                                    Style="{StaticResource TitleBarDividerStyle}"
                                    Tag="TitleBarChromeDivider"
                                    Uid="Community"/>
                            <!-- Community-Widgets in der Titelzeile -->
                            <WrapPanel x:Name="DashboardCommunityModule" Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="DashboardTitleBarCommunityWidget"
                                        Style="{StaticResource TitleBarWidgetStyle}"
                                        Tag="TitleBarChromeWidget"
                                        Uid="Community"
                                        MinWidth="250">
                                    <StackPanel>
                                        <TextBlock Text="COMMUNITY" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <UniformGrid Columns="4">
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock x:Name="DashboardHeroViewerText" Text="0" FontSize="22" FontWeight="SemiBold"/>
                                                <TextBlock Text="Zuschauer" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock x:Name="DashboardHeroFollowerText" Text="0" FontSize="22" FontWeight="SemiBold"/>
                                                <TextBlock Text="Follower" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock x:Name="DashboardChatAlertsText" Text="0" FontSize="22" FontWeight="SemiBold"/>
                                                <TextBlock Text="Abos" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Name="DashboardCommunityChattersText" Text="0" FontSize="22" FontWeight="SemiBold"/>
                                                <TextBlock Text="Chatter" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <Border Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource ComboGlyphBackgroundBrush}" BorderThickness="1" CornerRadius="5" Margin="0,10,0,0" Padding="6">
                                            <Grid>
                                                <Canvas Height="36" ClipToBounds="True">
                                                    <Polyline x:Name="DashboardViewerTrendLine" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                                                </Canvas>
                                                <TextBlock Text="-60 Min" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                                                <TextBlock Text="Jetzt" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TitleBarDividerStyle}"
                                        Tag="TitleBarChromeDivider"
                                        Uid="Session"/>
                                <Border x:Name="DashboardTitleBarSessionWidget"
                                        Style="{StaticResource TitleBarWidgetStyle}"
                                        Tag="TitleBarChromeWidget"
                                        Uid="Session"
                                        MinWidth="230">
                                    <StackPanel>
                                        <TextBlock Text="SESSION" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <UniformGrid Columns="4">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock x:Name="DashboardPeakViewersText" Text="0" FontSize="18" FontWeight="SemiBold"/>
                                                <TextBlock Text="Peak" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock x:Name="DashboardAverageViewersText" Text="0" FontSize="18" FontWeight="SemiBold"/>
                                                <TextBlock Text="Ø Zusch." Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock x:Name="DashboardFollowersGainedText" Text="0" FontSize="18" FontWeight="SemiBold"/>
                                                <TextBlock Text="Follower +" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                                <TextBlock x:Name="DashboardFollowerTotalText" Text="Gesamt: 0" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Name="DashboardCommunityUniqueChattersText" Text="0" FontSize="18" FontWeight="SemiBold"/>
                                                <TextBlock Text="Unique" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock x:Name="DashboardTwitchSessionMetricsText" Text="Subs 0 · Gift-Subs 0 · Bits 0 · Raids 0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="DashboardTwitchGoalsText" Text="Follower-Ziel: 0 / 0 · Sub-Ziel: 0 / 0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TitleBarDividerStyle}"
                                        Tag="TitleBarChromeDivider"
                                        Uid="Countdown"/>
                                <Border x:Name="DashboardCountdownModule"
                                        Style="{StaticResource TitleBarWidgetStyle}"
                                        Tag="TitleBarChromeWidget"
                                        Uid="Countdown"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                        MinWidth="205">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                            <TextBlock Text="COUNTDOWN" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="DashboardCountdownLabelText" Text="Countdown" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                        </DockPanel>
                                        <TextBlock x:Name="DashboardCountdownRemainingText" Text="10:00" Foreground="{DynamicResource AccentHoverBrush}" FontSize="28" FontWeight="Bold"/>
                                        <UniformGrid Columns="4" Margin="0,10,0,0">
                                            <Button x:Name="DashboardCountdownStartButton" Content="Start" Height="28" Margin="0,0,4,0" Padding="4,2" FontWeight="Bold" Style="{StaticResource OrangeActionButtonStyle}" ToolTip="Countdown starten"/>
                                            <Button x:Name="DashboardCountdownStopButton" Content="Stop" Height="28" Margin="0,0,4,0" Padding="4,2" ToolTip="Countdown stoppen"/>
                                            <Button x:Name="DashboardCountdownResetButton" Content="Reset" Height="28" Margin="0,0,4,0" Padding="4,2" ToolTip="Countdown zurücksetzen"/>
                                            <Button x:Name="DashboardCountdownSettingsButton" Content="⚙" Height="28" Padding="0" FontSize="14" ToolTip="Countdown-Einstellungen"/>
                                        </UniformGrid>
                                        <Popup x:Name="DashboardCountdownSettingsPopup"
                                               PlacementTarget="{Binding ElementName=DashboardCountdownSettingsButton}"
                                               Placement="Bottom"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Background="{DynamicResource ElevatedBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="14"
                                                    MinWidth="260"
                                                    MaxWidth="300">
                                                <StackPanel>
                                                    <TextBlock Text="Countdown einstellen" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                                                    <TextBlock Text="Label" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                    <TextBox x:Name="DashboardCountdownLabelBox" Text="Countdown" Margin="0,4,0,10" ToolTip="Overlay-Label"/>
                                                    <TextBlock Text="Dauer (Sekunden)" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                    <TextBox x:Name="DashboardCountdownSecondsBox" Text="600" Margin="0,4,0,8" ToolTip="Countdown-Dauer in Sekunden"/>
                                                    <TextBlock Text="Presets" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                                                    <UniformGrid Columns="3" Margin="0,0,0,12">
                                                        <Button x:Name="DashboardCountdownPreset5Button" Content="5 Min" Height="30" Margin="0,0,4,0" Tag="300"/>
                                                        <Button x:Name="DashboardCountdownPreset10Button" Content="10 Min" Height="30" Margin="0,0,4,0" Tag="600"/>
                                                        <Button x:Name="DashboardCountdownPreset30Button" Content="30 Min" Height="30" Margin="0" Tag="1800"/>
                                                    </UniformGrid>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button x:Name="DashboardCountdownSettingsCancelButton" Content="Abbrechen" MinWidth="88" Margin="0,0,8,0"/>
                                                        <Button x:Name="DashboardCountdownSettingsSaveButton" Content="Speichern" MinWidth="88" FontWeight="Bold"
                                                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextOnAccentBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            <!-- Kompatibilitäts-Host für Status/Connect-Controls -->
                            <StackPanel Visibility="Collapsed">
                                <Ellipse x:Name="ObsDashboardLamp"/>
                                <TextBlock x:Name="ObsDashboardStatus"/>
                                <Button x:Name="DashboardOpenObsServiceButton"/>
                                <Button x:Name="DashboardTopConnectObsButton"/>
                                <Ellipse x:Name="TwitchDashboardLamp"/>
                                <TextBlock x:Name="TwitchDashboardStatus"/>
                                <Button x:Name="DashboardOpenTwitchServiceButton"/>
                                <Button x:Name="DashboardTopConnectTwitchButton"/>
                                <Ellipse x:Name="SpotifyDashboardLamp"/>
                                <TextBlock x:Name="SpotifyDashboardStatus"/>
                                <Button x:Name="DashboardOpenSpotifyServiceButton"/>
                                <Button x:Name="DashboardTopConnectSpotifyButton"/>
                                <Ellipse x:Name="StreamerBotDashboardLamp"/>
                                <TextBlock x:Name="StreamerBotDashboardStatus"/>
                                <Button x:Name="DashboardOpenStreamerBotServiceButton"/>
                                <Button x:Name="DashboardTopConnectStreamerBotButton"/>
                                <Button x:Name="DashboardTopOpenStreamDeckButton"/>
                                <Ellipse x:Name="AlertsDashboardLamp"/>
                                <TextBlock x:Name="AlertsDashboardStatus"/>
                                <Button x:Name="DashboardOpenAlertsServiceButton"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseRightButtonUp="TitleBar_MouseRightButtonUp">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="TitleBarMinimizeButton"
                                Style="{StaticResource TitleBarCaptionButtonStyle}"
                                ToolTip="Minimieren"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TitleBarMinimizeButton_Click">
                            <Path Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.4"
                                  Data="M0,5 L10,5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="TitleBarMaximizeButton"
                                Style="{StaticResource TitleBarCaptionButtonStyle}"
                                ToolTip="Maximieren"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TitleBarMaximizeButton_Click">
                            <Grid Width="10" Height="10">
                                <Path x:Name="TitleBarMaximizeIcon"
                                      Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.4" Fill="Transparent"
                                      Data="M0,0 H10 V10 H0 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <Path x:Name="TitleBarRestoreIcon"
                                      Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.4" Fill="Transparent"
                                      Visibility="Collapsed"
                                      Data="M2.5,0 H10 V7.5 H2.5 Z M0,2.5 H7.5 V10 H0 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Grid>
                        </Button>
                        <Button x:Name="TitleBarCloseButton"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                ToolTip="Schließen"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="TitleBarCloseButton_Click">
                            <Path Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.4"
